# https://editorconfig.org — IDE'ler ve `dotnet format` bu kurallara uyar.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,csproj,props,targets}]
indent_size = 2

# Windows PowerShell 5.1, BOM'suz dosyayı ANSI sanır (Türkçe karakterler bozulur) → BOM şart.
[*.ps1]
charset = utf-8-bom
