<Window x:Class="CyberTodo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:local="clr-namespace:CyberTodo"
        xmlns:models="clr-namespace:CyberTodo.Models"
        xmlns:loc="clr-namespace:CyberTodo.Services"
        mc:Ignorable="po"
        Title="CALABATICA"
        Icon="pack://application:,,,/Assets/calabatica.ico"
        Width="1440" Height="860" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#000000"
        Foreground="#00F0FF"
        FontFamily="Cascadia Mono, Consolas"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Standart başlık çubuğu yok; kenarlardan yeniden boyutlandırma WindowChrome ile korunur. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Klavye kısayolları (Ctrl+N / Ctrl+F odak işlemleri code-behind'da) -->
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- ═════════════ Palet (dondurulmuş fırçalar) ═════════════ -->
        <!-- Tema renkleri: çalışma anında MainWindow.ApplyTheme ile değiştirilir (DynamicResource) -->
        <Color x:Key="PrimaryColor">#FCEE0A</Color>
        <Color x:Key="SecondaryColor">#00F0FF</Color>
        <SolidColorBrush x:Key="PrimaryDeepBrush" Color="#1A1800" po:Freeze="True" />
        <SolidColorBrush x:Key="YellowBrush" Color="#FCEE0A" po:Freeze="True" />
        <SolidColorBrush x:Key="CyanBrush" Color="#00F0FF" po:Freeze="True" />
        <SolidColorBrush x:Key="RedBrush" Color="#FF003C" po:Freeze="True" />
        <SolidColorBrush x:Key="GreenBrush" Color="#00FF66" po:Freeze="True" />
        <SolidColorBrush x:Key="GreyBrush" Color="#4A5568" po:Freeze="True" />
        <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" po:Freeze="True" />
        <SolidColorBrush x:Key="BlackBrush" Color="#000000" po:Freeze="True" />
        <SolidColorBrush x:Key="PanelBrush" Color="#050A0E" po:Freeze="True" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#070D12" po:Freeze="True" />
        <SolidColorBrush x:Key="CyanDimBrush" Color="#6600F0FF" po:Freeze="True" />
        <SolidColorBrush x:Key="CyanFaintBrush" Color="#1F00F0FF" po:Freeze="True" />
        <SolidColorBrush x:Key="YellowDimBrush" Color="#55FCEE0A" po:Freeze="True" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#8A94A6" po:Freeze="True" />
        <SolidColorBrush x:Key="AxisTextBrush" Color="#5CA9B3" po:Freeze="True" />
        <SolidColorBrush x:Key="DividerBrush" Color="#1E2630" po:Freeze="True" />
        <SolidColorBrush x:Key="BackdropBrush" Color="#C8000000" po:Freeze="True" />
        <!-- Neredeyse görünmez ama tıklanabilir (şeffaf pencerede alfa=0 piksel tıklamayı geçirir) -->
        <SolidColorBrush x:Key="HitTestBrush" Color="#01000000" po:Freeze="True" />

        <!--
            Yeniden boyutlandırma tutamacı: köşe kesik olduğu için varsayılan noktalı kare boşlukta kalıyordu.
            Yerine kesik köşeye paralel üç sarı çentik (çerçevenin içinde) — HUD aksanı gibi görünür.
            34x34 alan: kesik çizgi bu alanda x+y=38 doğrusunda; çentikler x+y=31/26/21 üzerinde.
        -->
        <Style TargetType="ResizeGrip">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="SizeNWSE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ResizeGrip">
                        <Grid Background="{StaticResource HitTestBrush}">
                            <Path Stroke="{DynamicResource YellowBrush}" StrokeThickness="1.5"
                                  Data="M13,18 L18,13 M10,16 L16,10 M8,13 L13,8" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═════════════ Butonlar ═════════════ -->
        <Style x:Key="ChamferButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource CyanBrush}" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <local:ChamferFrame x:Name="Frame"
                                                Fill="{TemplateBinding Background}"
                                                Stroke="{TemplateBinding BorderBrush}"
                                                StrokeThickness="1.5"
                                                Chamfer="10"
                                                Corners="TopLeft, BottomRight" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="StrokeThickness" Value="2.5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="StrokeThickness" Value="1" />
                            </Trigger>
                            <!-- Devre dışı: saydamlık yerine gri renk (Opacity ara katmanı kesirli ölçekte iz bırakıyordu) -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource GreyBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource GreyBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource ChamferButton}">
            <Setter Property="Foreground" Value="{DynamicResource YellowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource YellowBrush}" />
            <Setter Property="Padding" Value="18,6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource YellowBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource BlackBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ChamferButton}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- Gün çipi (DataContext = DayToggle): seçiliyse cyan dolgu + siyah metin -->
        <Style x:Key="DayChipButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
            <Setter Property="MinWidth" Value="52" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CyanBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource BlackBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource ChamferButton}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- Pencere butonları (ayarlar / küçült / kapat) -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource YellowDimBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource YellowBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <local:ChamferFrame Fill="{TemplateBinding Background}"
                                                Stroke="{TemplateBinding BorderBrush}"
                                                StrokeThickness="1.5"
                                                Chamfer="7"
                                                Corners="TopLeft, BottomRight" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource YellowBrush}" />
                    <Setter Property="Background" Value="{DynamicResource PrimaryDeepBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
                    <Setter Property="Background" Value="{StaticResource RedBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource BlackBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Satır içi ikon butonu (✎ / ✕) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource CyanBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeleteIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            Satır içi ikonlar: varsayılan soluk gri, satırın üzerine gelince açık gri, ikonun üzerine gelince cyan/kırmızı.
            (Opacity kullanılmaz: ara katman kesirli ölçekte kutu/kırpma izi bırakıyordu.)
            Tetikleyici sırası önemli: en son tanımlanan kazanır → ikon hover'ı satır hover'ını ezer.
        -->
        <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="{StaticResource GreyBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource CyanBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowDeleteButton" TargetType="Button" BasedOn="{StaticResource RowIconButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Aktif görev kutusu: boş kare, üzerine gelince tik önizlemesi -->
        <Style x:Key="TaskCheckButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{StaticResource PanelAltBrush}">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" />
                            <Path x:Name="Check" Data="M6,14 L11,19 L22,8" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tamamlanan görev kutusu: gri tik, üzerine gelince cyan (geri al) -->
        <Style x:Key="DoneCheckButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="BorderBrush" Value="{StaticResource GreyBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" />
                            <Path Data="M6,14 L11,19 L22,8" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Küçük kutu (alt görevler): içerik (tik) DataTemplate'ten verilir ki tetikleyici erişebilsin -->
        <Style x:Key="MiniCheckButton" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="BorderBrush" Value="{DynamicResource CyanDimBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{StaticResource PanelAltBrush}">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" />
                            <ContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Neon ProgressBar: animasyonsuz, efektsiz (liste içinde güvenli) -->
        <Style x:Key="NeonProgress" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource CyanBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <!--
                            Soluk kenar Opacity ile DEĞİL, üstüne yarı saydam koyu katmanla:
                            Opacity ara katman açar; kesirli ölçekte (%85) katman sınırı yuvarlanıp alt kenarı kırpıyordu.
                        -->
                        <Grid Background="Transparent">
                            <Border Background="#0A1016" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" />
                            <Rectangle Fill="#66070D12" IsHitTestVisible="False" />
                            <Grid x:Name="PART_Track" Margin="3">
                                <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox: Tag = boşken görünen ipucu metni -->
        <Style x:Key="NeonTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource CyanBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CyanDimBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource YellowBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource CyanBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <!--
                GPU render'ında kırpılan (clip) alanların üst/alt kenarında ince açık renkli çizgi kalıyor
                (yazılım render'ında yok). Kırpma katmanında kenar yumuşatmayı kapatmak çizgiyi kaldırıyor;
                TextBox içinde sadece metin olduğu için görsel kayıp yok.
            -->
            <Setter Property="RenderOptions.EdgeMode" Value="Aliased" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid Margin="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                                <TextBlock x:Name="Hint"
                                           Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource GreyBrush}"
                                           FontStyle="Italic"
                                           IsHitTestVisible="False"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{TemplateBinding Tag}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource YellowBrush}" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- İnce neon ScrollBar (dikey + yatay şablon) -->
        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Background="{StaticResource PanelBrush}">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.Thumb>
                        <Thumb>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Rectangle Fill="{DynamicResource CyanDimBrush}" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Background="{StaticResource PanelBrush}">
                <Track x:Name="PART_Track">
                    <Track.Thumb>
                        <Thumb>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Rectangle Fill="{DynamicResource CyanDimBrush}" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="6" />
                    <Setter Property="MinHeight" Value="6" />
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═════════════ Seçim çipleri (LocalizedOption listeleri) ═════════════ -->
        <Style x:Key="ChipItemStyle" TargetType="ListBoxItem">
            <Setter Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <local:ChamferFrame x:Name="Frame"
                                                Fill="{StaticResource PanelAltBrush}"
                                                Stroke="{TemplateBinding BorderBrush}"
                                                StrokeThickness="1.5"
                                                Chamfer="7"
                                                Corners="TopLeft, BottomRight" />
                            <ContentPresenter x:Name="Content"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding BorderBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="StrokeThickness" Value="2.5" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="Fill"
                                        Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource BlackBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Öncelik çipi: renk Value'ya göre -->
        <Style x:Key="PriorityChipStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ChipItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Value}" Value="HighPriority">
                    <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Value}" Value="Decrypting">
                    <Setter Property="BorderBrush" Value="{DynamicResource YellowBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="OptionLabelTemplate">
            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Label}" />
        </DataTemplate>

        <Style x:Key="ChipList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChipItemStyle}" />
            <Setter Property="ItemTemplate" Value="{StaticResource OptionLabelTemplate}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Log satırı durum etiketi (dile göre) -->
        <Style x:Key="LogTagRun" TargetType="Run">
            <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
            <Setter Property="Text" Value="" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter Property="Text" Value="{loc:Tr Log_Done}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Passed">
                    <Setter Property="Text" Value="{loc:Tr Log_Passed}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Text" Value="{loc:Tr Log_Failed}" />
                    <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Focus">
                    <Setter Property="Text" Value="{loc:Tr Log_Focus}" />
                    <Setter Property="Foreground" Value="{DynamicResource YellowBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="Margin" Value="0,12,0,5" />
        </Style>

        <!-- Overlay görünürlüğü: bağlı değer null ise gizli -->
        <Style x:Key="OverlayWhenEditor" TargetType="Grid">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Editor}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ═════════════ Veri şablonları (EFEKT YOK) ═════════════ -->

        <DataTemplate x:Key="SubtaskRowTemplate" DataType="{x:Type models:SubTask}">
            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                <Button Style="{StaticResource MiniCheckButton}"
                        VerticalAlignment="Center"
                        Command="{Binding DataContext.ToggleSubtaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <Path x:Name="SubCheck" Data="M3,9 L7,13 L14,4" Stroke="{DynamicResource CyanBrush}" StrokeThickness="2" Visibility="Hidden" />
                </Button>
                <TextBlock x:Name="SubTitle" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14"
                           Foreground="{DynamicResource CyanBrush}" Text="{Binding Title}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="SubCheck" Property="Visibility" Value="Visible" />
                    <Setter TargetName="SubTitle" Property="Foreground" Value="{StaticResource GreyBrush}" />
                    <Setter TargetName="SubTitle" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ActiveTaskTemplate" DataType="{x:Type models:CyberTask}">
            <!-- Sürükle-bırak: satır bırakma hedefi; tutamaç (⠿) veya başlıktan sürüklenir -->
            <Grid x:Name="Row" Margin="0,0,10,20" Background="Transparent"
                  AllowDrop="True" DragOver="Row_DragOver" Drop="Row_Drop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Bırakma çizgisi: sürüklenen görev bu satırın üstüne gelecek -->
                <Border x:Name="DropLine" Grid.ColumnSpan="4" Height="3" Margin="0,-12,0,0" VerticalAlignment="Top"
                        Background="{DynamicResource CyanBrush}" Visibility="Collapsed" IsHitTestVisible="False" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="DragHandle" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="16"
                               Foreground="{StaticResource GreyBrush}" Text="⠿" Cursor="SizeAll" Background="Transparent"
                               ToolTip="{loc:Tr Tip_Drag}"
                               PreviewMouseLeftButtonDown="DragSource_MouseDown" MouseMove="DragSource_MouseMove" />
                    <Button x:Name="CheckBtn"
                            Style="{StaticResource TaskCheckButton}"
                            Margin="0,0,18,0"
                            VerticalAlignment="Center"
                            ToolTip="{loc:Tr Tip_Complete}"
                            Command="{Binding DataContext.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </StackPanel>

                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           Background="Transparent"
                           PreviewMouseLeftButtonDown="DragSource_MouseDown" MouseMove="DragSource_MouseMove"
                           VerticalAlignment="Center"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource CyanBrush}"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Code, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Title, Mode=OneWay}" />
                </TextBlock>

                <TextBlock x:Name="StatusTag"
                           Grid.Column="2"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="{loc:Tr Prio_Active}"
                           Foreground="{StaticResource GreenBrush}" />

                <StackPanel x:Name="Actions" Grid.Column="3" Margin="8,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="FocusBtn" Style="{StaticResource RowIconButton}" Content="▶" ToolTip="{loc:Tr Tip_Focus}"
                            Command="{Binding DataContext.StartFocusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <Button Style="{StaticResource RowIconButton}" Content="✎" ToolTip="{loc:Tr Tip_Edit}"
                            Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <Button Style="{StaticResource RowDeleteButton}" Content="✕" ToolTip="{loc:Tr Tip_Delete}"
                            Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </StackPanel>

                <!-- Meta satırı: kategori, son tarih, tekrar, alt görev sayacı (boş olanlar gizli) -->
                <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                    <Border x:Name="CategoryChip" Margin="0,6,10,0" Padding="7,1" BorderThickness="1" BorderBrush="{DynamicResource CyanDimBrush}">
                        <TextBlock FontSize="12" Foreground="{DynamicResource AxisTextBrush}">
                            <Run Text="#" /><Run Text="{Binding Category, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <TextBlock x:Name="DueChip" Margin="0,6,10,0" FontSize="13" Foreground="{DynamicResource AxisTextBrush}">
                        <Run Text="⏱ " /><Run Text="{Binding DueText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock x:Name="RecurChip" Margin="0,6,10,0" FontSize="13" Foreground="{DynamicResource AxisTextBrush}">
                        <Run Text="↻ " /><Run Text="{Binding RecurrenceText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock x:Name="ReminderChip" Margin="0,6,10,0" FontSize="13" Foreground="{DynamicResource AxisTextBrush}" Text="⏰" Visibility="Collapsed" />
                    <TextBlock x:Name="TrackedChip" Margin="0,6,10,0" FontSize="13" Foreground="{DynamicResource YellowBrush}">
                        <Run Text="◉ " /><Run Text="{Binding TrackedText, Mode=OneWay}" />
                    </TextBlock>
                    <Button x:Name="SubtaskChip"
                            Margin="0,4,10,0"
                            Style="{StaticResource IconButton}"
                            Width="Auto"
                            Padding="6,0"
                            FontSize="13"
                            Foreground="{DynamicResource AxisTextBrush}"
                            ToolTip="{loc:Tr Tip_Subtasks}"
                            Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <TextBlock Margin="4,0">
                            <Run x:Name="ExpandGlyph" Text="▸ " /><Run x:Name="NotesGlyph" Text="✎ " /><Run x:Name="SubtaskGlyph" Text="☑ " /><Run Text="{Binding SubtaskSummary, Mode=OneWay}" />
                        </TextBlock>
                    </Button>
                </WrapPanel>

                <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="54" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="ProgressBarItem"
                                 Style="{StaticResource NeonProgress}"
                                 Value="{Binding Progress, Mode=OneWay}"
                                 Cursor="Hand"
                                 ToolTip="{loc:Tr Tip_Progress}"
                                 MouseLeftButtonDown="Progress_MouseLeftButtonDown" />
                    <TextBlock x:Name="PercentText"
                               Grid.Column="1"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource CyanBrush}"
                               Text="{Binding Progress, StringFormat={}{0:0}%}" />
                </Grid>

                <!-- Genişletilmiş ayrıntılar: notlar + alt görevler -->
                <StackPanel x:Name="DetailsPanel" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="4,6,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="NotesText" Margin="0,2,0,4" FontSize="13" Foreground="{StaticResource SubtleTextBrush}"
                               TextWrapping="Wrap" Text="{Binding Notes}" />
                    <ItemsControl Focusable="False" ItemsSource="{Binding Subtasks}" ItemTemplate="{StaticResource SubtaskRowTemplate}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="HighPriority">
                    <Setter TargetName="CheckBtn" Property="BorderBrush" Value="{StaticResource RedBrush}" />
                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource RedBrush}" />
                    <Setter TargetName="StatusTag" Property="Text" Value="{loc:Tr Prio_High}" />
                    <Setter TargetName="StatusTag" Property="Foreground" Value="{StaticResource RedBrush}" />
                    <Setter TargetName="ProgressBarItem" Property="Foreground" Value="{StaticResource RedBrush}" />
                    <Setter TargetName="PercentText" Property="Foreground" Value="{StaticResource RedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="Decrypting">
                    <Setter TargetName="CheckBtn" Property="BorderBrush" Value="{DynamicResource YellowBrush}" />
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                    <Setter TargetName="StatusTag" Property="Text" Value="{loc:Tr Prio_Decrypt}" />
                    <Setter TargetName="StatusTag" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                    <Setter TargetName="ProgressBarItem" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                    <Setter TargetName="PercentText" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding Category}" Value="{x:Null}">
                    <Setter TargetName="CategoryChip" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DueState}" Value="None">
                    <Setter TargetName="DueChip" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DueState}" Value="Today">
                    <Setter TargetName="DueChip" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DueState}" Value="Overdue">
                    <Setter TargetName="DueChip" Property="Foreground" Value="{StaticResource RedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Recurrence}" Value="None">
                    <Setter TargetName="RecurChip" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ReminderFired}" Value="False">
                    <Setter TargetName="ReminderChip" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ReminderMinutesBefore}" Value="{x:Null}">
                    <Setter TargetName="ReminderChip" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasDetails}" Value="False">
                    <Setter TargetName="SubtaskChip" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasNotes}" Value="False">
                    <Setter TargetName="NotesGlyph" Property="Text" Value="" />
                    <Setter TargetName="NotesText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasSubtasks}" Value="False">
                    <Setter TargetName="SubtaskGlyph" Property="Text" Value="" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="DetailsPanel" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ExpandGlyph" Property="Text" Value="▾ " />
                </DataTrigger>
                <DataTrigger Binding="{Binding TrackedText}" Value="">
                    <Setter TargetName="TrackedChip" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFocused}" Value="True">
                    <Setter TargetName="FocusBtn" Property="Content" Value="■" />
                    <Setter TargetName="FocusBtn" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                    <Setter TargetName="FocusBtn" Property="ToolTip" Value="{loc:Tr Tip_StopFocus}" />
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="DragHandle" Property="Foreground" Value="{DynamicResource CyanBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="DropLine" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDropAfter}" Value="True">
                    <Setter TargetName="DropLine" Property="VerticalAlignment" Value="Bottom" />
                    <Setter TargetName="DropLine" Property="Grid.Row" Value="3" />
                    <Setter TargetName="DropLine" Property="Margin" Value="0,0,0,-12" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="CompletedTaskTemplate" DataType="{x:Type models:CyberTask}">
            <Grid x:Name="Row" Margin="0,0,10,12" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource DoneCheckButton}"
                        Margin="0,0,18,0"
                        VerticalAlignment="Center"
                        ToolTip="{loc:Tr Tip_Restore}"
                        Command="{Binding DataContext.RestoreTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="18"
                           Foreground="{StaticResource GreyBrush}"
                           TextDecorations="Strikethrough"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Code, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Title, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{StaticResource GreyBrush}"
                           Text="{Binding CompletedAt, StringFormat='[✓ {0:dd.MM HH:mm}]'}" />
                <Button x:Name="DeleteBtn" Grid.Column="3" Margin="8,0,0,0"
                        Style="{StaticResource RowDeleteButton}" Content="✕" ToolTip="{loc:Tr Tip_Delete}"
                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LogEntryTemplate" DataType="{x:Type models:ActivityLogEntry}">
            <TextBlock Margin="0,3" FontSize="15" Foreground="{DynamicResource CyanBrush}" TextWrapping="Wrap">
                <Run Text="◷ " /><Run Text="{Binding Time, Mode=OneWay}" /><Run Text=" - " /><Run Text="{Binding Description, Mode=OneWay}" /><Run Style="{StaticResource LogTagRun}" />
            </TextBlock>
        </DataTemplate>

        <!-- Grafik sütunu: nişangâh + beyaz çerçeve SADECE fare üzerindeyken -->
        <DataTemplate x:Key="ChartBarTemplate" DataType="{x:Type models:ChartBar}">
            <Grid Background="Transparent" Cursor="Hand" MouseEnter="Bar_MouseEnter">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding EmptyHeight}" />
                    <RowDefinition Height="{Binding FillHeight}" />
                </Grid.RowDefinitions>
                <Border x:Name="BarRect"
                        Grid.Row="1"
                        Margin="3,0"
                        MaxWidth="38"
                        Background="{DynamicResource CyanBrush}"
                        BorderBrush="Transparent"
                        BorderThickness="0" />
                <!-- Canvas boyutu 0: halka sütun tepesinde ortalanır ve kırpılmaz -->
                <Canvas x:Name="Reticle"
                        Grid.Row="1"
                        Width="0" Height="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <Ellipse Canvas.Left="-14" Canvas.Top="-14" Width="28" Height="28"
                             Stroke="{DynamicResource YellowBrush}" StrokeThickness="1.5" />
                    <Path Stroke="{DynamicResource YellowBrush}" StrokeThickness="1.5"
                          Data="M-20,0 L-9,0 M9,0 L20,0 M0,-20 L0,-9" />
                </Canvas>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Intensity}" Value="None">
                    <Setter TargetName="BarRect" Property="Background" Value="{StaticResource GreyBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="Medium">
                    <Setter TargetName="BarRect" Property="Background" Value="{DynamicResource YellowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="High">
                    <Setter TargetName="BarRect" Property="Background" Value="{StaticResource RedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHovered}" Value="True">
                    <Setter TargetName="BarRect" Property="BorderBrush" Value="{StaticResource WhiteBrush}" />
                    <Setter TargetName="BarRect" Property="BorderThickness" Value="2" />
                    <Setter TargetName="Reticle" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- X ekseni etiketi: negatif margin → dar hücreden taşan metin kırpılmaz -->
        <DataTemplate x:Key="ChartLabelTemplate" DataType="{x:Type models:ChartBar}">
            <TextBlock x:Name="Lbl"
                       Margin="-40,0"
                       TextAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource AxisTextBrush}"
                       Text="{Binding Label}"
                       Visibility="Hidden" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ShowLabel}" Value="True">
                    <Setter TargetName="Lbl" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHovered}" Value="True">
                    <Setter TargetName="Lbl" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ToastTemplate" DataType="{x:Type models:ToastItem}">
            <Grid Margin="0,10,0,0">
                <local:ChamferFrame x:Name="ToastFrame" Fill="{StaticResource PanelAltBrush}" Stroke="{DynamicResource CyanBrush}"
                                    StrokeThickness="1.5" Chamfer="10" Corners="TopLeft, BottomRight" />
                <Grid Margin="16,12,10,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ToastText" VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap"
                               Foreground="{DynamicResource CyanBrush}" Text="{Binding Message}" />
                    <Button x:Name="ToastAction" Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource SmallButton}"
                            Content="{Binding ActionLabel}"
                            Command="{Binding DataContext.RunToastActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="✕" ToolTip="{loc:Tr Tip_Dismiss}"
                            Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasAction}" Value="False">
                    <Setter TargetName="ToastAction" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Reminder">
                    <Setter TargetName="ToastFrame" Property="Stroke" Value="{DynamicResource YellowBrush}" />
                    <Setter TargetName="ToastText" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="EditorSubtaskTemplate" DataType="{x:Type models:SubTask}">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource MiniCheckButton}" VerticalAlignment="Center" Click="EditorSubtaskToggle_Click">
                    <Path x:Name="SubCheck" Data="M3,9 L7,13 L14,4" Stroke="{DynamicResource CyanBrush}" StrokeThickness="2" Visibility="Hidden" />
                </Button>
                <TextBlock x:Name="SubTitle" Grid.Column="1" Margin="10,0" VerticalAlignment="Center" FontSize="14"
                           Foreground="{DynamicResource CyanBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                <Button Grid.Column="2" Style="{StaticResource DeleteIconButton}" Content="✕" ToolTip="{loc:Tr Tip_Delete}"
                        Command="{Binding DataContext.Editor.RemoveSubtaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="SubCheck" Property="Visibility" Value="Visible" />
                    <Setter TargetName="SubTitle" Property="Foreground" Value="{StaticResource GreyBrush}" />
                    <Setter TargetName="SubTitle" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            Sanallaştırılmış görev listesi: yalnızca görünen satırlar oluşturulur, kaydırırken satırlar yeniden kullanılır.
            (Önceden ScrollViewer içindeki düz ItemsControl 2500 görevde ~18 sn açılış / 570 MB'a çıkıyordu.)
            ScrollViewer kontrolün KENDİ şablonunda olmalı ki panel kaydırmayı yönetebilsin (CanContentScroll).
            EdgeMode: kırpma kenarı çizgisi düzeltmesi (bkz. NeonTextBox); içerik yumuşatmalı kalır.
        -->
        <ControlTemplate x:Key="VirtualItemsTemplate" TargetType="ItemsControl">
            <ScrollViewer Focusable="False"
                          CanContentScroll="True"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Background="{TemplateBinding Background}"
                          RenderOptions.EdgeMode="Aliased">
                <ItemsPresenter RenderOptions.EdgeMode="Unspecified" />
            </ScrollViewer>
        </ControlTemplate>

        <Style x:Key="VirtualList" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template" Value="{StaticResource VirtualItemsTemplate}" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="SingleRowPanel">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!--
            Ana dış çerçeve: pencere kenarına oturur, 4 köşe 45° kesik (simetrik), kesik çizgi sarı.
            Kesik çizginin dışındaki üçgenler cyan dolgu (CornerFill) → pencere tamamen opak kalır,
            şeffaf pencere (AllowsTransparency) gerekmez; GPU render yolu korunur.
            Ölçeklenmez → kenar her ölçekte sabit 2px.
        -->
        <local:ChamferFrame Fill="{StaticResource BlackBrush}"
                            Stroke="{DynamicResource YellowBrush}"
                            CornerFill="{DynamicResource CyanBrush}"
                            StrokeThickness="2"
                            Chamfer="30"
                            Corners="All" />
        <Rectangle Width="4" Height="70" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource YellowBrush}" />
        <Rectangle Width="4" Height="70" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{DynamicResource YellowBrush}" />

        <!--
            İçerik ölçeği: pencere boyutu aynı kalır, tüm yapı UiScale oranında küçülür (varsayılan %85).
            Margin dönüşümün DIŞINDA uygulanır (ölçeklenmez): başlık hiçbir ölçekte kesik köşeye yaklaşmaz
            ve sol/sağ boşluk eşit kalır.
        -->
        <Grid x:Name="ScaleHost" Margin="40,18,40,24">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
            </Grid.LayoutTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ═════════════ ÜST BAR (sürüklenebilir) ═════════════ -->
                <Grid x:Name="HeaderBar" Background="{StaticResource HitTestBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Odak (Pomodoro) göstergesi: başlığın ortasında, sadece çalışırken -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                        <Grid.Visibility>
                            <Binding Path="IsFocusRunning">
                                <Binding.Converter>
                                    <BooleanToVisibilityConverter />
                                </Binding.Converter>
                            </Binding>
                        </Grid.Visibility>
                        <local:ChamferFrame Fill="{StaticResource PanelAltBrush}" Stroke="{DynamicResource YellowBrush}"
                                            StrokeThickness="1.5" Chamfer="8" Corners="TopLeft, BottomRight" />
                        <Grid Margin="14,6,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource YellowBrush}" MaxWidth="360" TextTrimming="CharacterEllipsis">
                                <Run Text="◉ " /><Run Text="{loc:Tr Focus_Label}" /><Run Text=" · " /><Run Text="{Binding FocusTask.Code, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding FocusTask.Title, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource YellowBrush}" Text="{Binding FocusRemainingText}" />
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="■" Foreground="{DynamicResource YellowBrush}"
                                    ToolTip="{loc:Tr Tip_StopFocus}" Command="{Binding StopFocusCommand}" />
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Height="5" Margin="0,5,0,0" Style="{StaticResource NeonProgress}"
                                         Foreground="{DynamicResource YellowBrush}" Maximum="1" Value="{Binding FocusProgress, Mode=OneWay}" />
                        </Grid>
                    </Grid>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="32" FontWeight="Bold" Foreground="{DynamicResource YellowBrush}" TextTrimming="CharacterEllipsis">
                                <!-- Glow #1 (izin verilen tekil eleman) -->
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="{DynamicResource PrimaryColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.85" />
                                </TextBlock.Effect>
                                <!-- Sürüm exe'den okunur; yayın derlemesinde GitHub etiketinden gelir -->
                                <Run Text="CALABATICA" /><Run Text=" " /><Run FontSize="16" Foreground="{DynamicResource YellowDimBrush}" Text="{Binding VersionText, Mode=OneWay}" />
                            </TextBlock>
                            <!-- GitHub'da daha yeni sürüm varsa: ▲ v1.1 (tıkla → yayın sayfası) -->
                            <Button Margin="12,0,0,4" VerticalAlignment="Bottom" Style="{StaticResource SmallButton}"
                                    Content="{Binding UpdateBadgeText}" ToolTip="{loc:Tr Tip_UpdateAvailable}"
                                    Command="{Binding OpenReleasePageCommand}">
                                <Button.Visibility>
                                    <Binding Path="HasUpdate">
                                        <Binding.Converter>
                                            <BooleanToVisibilityConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </Button.Visibility>
                            </Button>
                        </StackPanel>

                        <StackPanel Margin="2,6,0,0" Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock MaxWidth="900" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource RedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding ErrorMessage, StringFormat='!! {0}'}"
                                       ToolTip="{Binding ErrorMessage}" />
                            <Button Style="{StaticResource CaptionCloseButton}" Width="26" Height="20" Margin="10,0,0,0" FontSize="10"
                                    Content="✕" ToolTip="{loc:Tr Tip_Dismiss}" Command="{Binding DismissErrorCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Başlıkla aynı dikey eksende (simetri) -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionButton}" Content="⚙" ToolTip="{loc:Tr Tip_Settings}" Command="{Binding OpenSettingsCommand}" />
                        <Button Style="{StaticResource CaptionButton}" Content="─" ToolTip="{loc:Tr Tip_Minimize}" Click="Minimize_Click" />
                        <Button Style="{StaticResource CaptionCloseButton}" Content="✕" ToolTip="{loc:Tr Tip_Close}" Click="Close_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,18">
                    <Rectangle Height="1" Fill="{DynamicResource YellowDimBrush}" />
                    <Rectangle Width="100" Height="3" HorizontalAlignment="Left" Fill="{DynamicResource YellowBrush}" />
                    <Rectangle Width="100" Height="3" HorizontalAlignment="Right" Fill="{DynamicResource YellowBrush}" />
                </Grid>

                <!-- ═════════════ İÇERİK ═════════════ -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.12*" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ───────── SOL: GÖREVLER ───────── -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource WhiteBrush}" Text="{loc:Tr Tasks_Header}" />
                            <Grid Margin="0,8,0,0">
                                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" />
                                <Rectangle Width="48" Height="3" HorizontalAlignment="Left" Fill="{StaticResource SubtleTextBrush}" />
                            </Grid>
                        </StackPanel>

                        <!-- Hızlı görev ekleme (Enter = + EKLE) -->
                        <Grid Grid.Row="1" Margin="0,14,0,14">
                            <Grid.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddTaskCommand}" />
                            </Grid.InputBindings>
                            <local:ChamferFrame Fill="{StaticResource PanelBrush}" Stroke="{DynamicResource CyanFaintBrush}"
                                                StrokeThickness="1" Chamfer="12" Corners="TopRight, BottomLeft" />
                            <Grid Margin="16,10,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Margin="0,0,0,5" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Text="{loc:Tr Add_TitleLabel}" />
                                <TextBlock Grid.Column="1" Margin="12,0,0,5" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Text="{loc:Tr Add_CategoryLabel}" />
                                <TextBlock Grid.Column="2" Margin="12,0,0,5" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Text="{loc:Tr Add_HoursLabel}" />

                                <TextBox x:Name="TaskTitleBox" Grid.Row="1" Style="{StaticResource NeonTextBox}" MaxLength="200"
                                         Tag="{loc:Tr Add_TitleHint}" ToolTip="{loc:Tr QuickAdd_Help}"
                                         Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource NeonTextBox}" MaxLength="40"
                                         Tag="{loc:Tr Add_CategoryHint}"
                                         Text="{Binding NewTaskCategory, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="1" Grid.Column="2" Width="80" Margin="12,0,0,0" Style="{StaticResource NeonTextBox}" MaxLength="5"
                                         HorizontalContentAlignment="Center"
                                         Text="{Binding NewTaskHours, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Row="1" Grid.Column="3" Margin="12,0,0,0" Style="{StaticResource AddButton}"
                                        Content="{loc:Tr Add_Button}" Command="{Binding AddTaskCommand}" />

                                <!-- Hızlı ekleme komutlarının canlı önizlemesi -->
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Margin="2,6,0,0" FontSize="13" Foreground="{DynamicResource YellowBrush}"
                                           TextTrimming="CharacterEllipsis" Text="{Binding QuickAddPreview}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding QuickAddPreview}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ListBox Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0"
                                         Style="{StaticResource ChipList}"
                                         ItemContainerStyle="{StaticResource PriorityChipStyle}"
                                         ItemsSource="{Binding PriorityOptions}"
                                         SelectedItem="{Binding SelectedPriorityOption}" />
                                <Button Grid.Row="3" Grid.Column="3" Margin="12,10,0,6" VerticalAlignment="Top" HorizontalAlignment="Right"
                                        Style="{StaticResource SmallButton}" Content="{loc:Tr Templates_Button}"
                                        Command="{Binding OpenTemplatesCommand}" />
                            </Grid>
                        </Grid>

                        <!-- Arama + sıralama + kategori filtresi -->
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="SearchBox" Style="{StaticResource NeonTextBox}" Tag="{loc:Tr Search_Hint}" VerticalAlignment="Top"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Grid.Column="1" Margin="14,4,0,0" Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Margin="0,6,10,0" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Text="{loc:Tr Sort_Label}" />
                                <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" />
                            </StackPanel>
                            <!-- Akıllı listeler: TÜMÜ / BUGÜN / YAKLAŞAN / GECİKMİŞ (sayaçlı) -->
                            <ListBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                     Style="{StaticResource ChipList}"
                                     ItemsSource="{Binding SmartViews}"
                                     SelectedItem="{Binding SelectedSmartView}" />

                            <ListBox Grid.Row="2" Grid.ColumnSpan="2" Margin="0,2,0,0"
                                     Style="{StaticResource ChipList}"
                                     ItemsSource="{Binding CategoryFilters}"
                                     SelectedItem="{Binding SelectedCategoryFilter}">
                                <ListBox.Visibility>
                                    <Binding Path="HasCategories">
                                        <Binding.Converter>
                                            <BooleanToVisibilityConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </ListBox.Visibility>
                            </ListBox>
                        </Grid>

                        <!-- Aktif görevler -->
                        <Grid Grid.Row="3">
                            <!-- Sanal liste; satırların altındaki boş alana bırakılırsa listenin sonuna taşınır -->
                            <ItemsControl x:Name="ActiveList" Style="{StaticResource VirtualList}"
                                          ItemsSource="{Binding ActiveView}" ItemTemplate="{StaticResource ActiveTaskTemplate}"
                                          AllowDrop="True" DragOver="ListEnd_DragOver" Drop="ListEnd_Drop" />
                            <TextBlock Margin="46,6,0,0" FontSize="15" Foreground="{StaticResource GreyBrush}" Text="{loc:Tr Empty_Active}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveView.IsEmpty}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Tamamlananlar -->
                        <StackPanel Grid.Row="4" Margin="0,10,0,12">
                            <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource GreyBrush}">
                                <Run Text="{loc:Tr Completed_Header}" /><Run Text="{Binding CompletedTasks.Count, Mode=OneWay, StringFormat=' [{0}]'}" />
                            </TextBlock>
                            <Rectangle Height="1" Margin="0,8,0,0" Fill="{StaticResource DividerBrush}" />
                        </StackPanel>

                        <ItemsControl Grid.Row="5" MaxHeight="170" Style="{StaticResource VirtualList}"
                                      ItemsSource="{Binding CompletedView}" ItemTemplate="{StaticResource CompletedTaskTemplate}" />
                    </Grid>

                    <!-- ───────── SAĞ: LOG + GRAFİK ───────── -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="250" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- AKTİVİTE LOGU: çift cyan çerçeve + glow #2 (izin verilen tekil eleman) -->
                        <Grid Margin="0,2,0,0">
                            <local:ChamferFrame Fill="{StaticResource PanelBrush}" Stroke="{DynamicResource CyanBrush}"
                                                StrokeThickness="2" Chamfer="20" Corners="TopLeft, BottomRight">
                                <local:ChamferFrame.Effect>
                                    <DropShadowEffect Color="{DynamicResource SecondaryColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.7" />
                                </local:ChamferFrame.Effect>
                            </local:ChamferFrame>
                            <local:ChamferFrame Margin="6" Stroke="{DynamicResource CyanDimBrush}" StrokeThickness="1" Chamfer="16"
                                                Corners="TopLeft, BottomRight" IsHitTestVisible="False" />

                            <Grid Margin="24,16,24,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource CyanBrush}"
                                           TextTrimming="CharacterEllipsis" Text="{Binding SelectedDayTitle}" />
                                <Rectangle Grid.Row="1" Height="1" Margin="0,8,0,8" Fill="{DynamicResource CyanDimBrush}" />

                                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False" RenderOptions.EdgeMode="Aliased">
                                    <ItemsControl ItemsSource="{Binding SelectedDay.Entries}" ItemTemplate="{StaticResource LogEntryTemplate}" Focusable="False" RenderOptions.EdgeMode="Unspecified" />
                                </ScrollViewer>
                                <TextBlock Grid.Row="2" FontSize="14" Foreground="{StaticResource GreyBrush}" Text="{loc:Tr Empty_Log}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDay.Entries.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Row="3" Margin="0,8,0,0" FontSize="15" Foreground="{DynamicResource CyanBrush}" Text="{Binding SelectedDaySummary}" />
                            </Grid>
                        </Grid>

                        <TextBlock Grid.Row="1" Margin="0,22,0,12" FontSize="26" FontWeight="Bold" Foreground="{StaticResource WhiteBrush}" Text="{loc:Tr Chart_Header}" />

                        <!-- Grafik paneli -->
                        <Grid Grid.Row="2">
                            <local:ChamferFrame Fill="{StaticResource PanelBrush}" Stroke="{DynamicResource CyanDimBrush}"
                                                StrokeThickness="1" Chamfer="16" Corners="BottomRight" />
                            <Grid Margin="14,12,22,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource CyanDimBrush}" />
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="{loc:Tr Tab_30}" Command="{Binding ShowLast30DaysCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChartMode}" Value="Last30">
                                                            <Setter Property="Background" Value="{DynamicResource CyanBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource BlackBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{loc:Tr Tab_7}" Command="{Binding ShowLast7DaysCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChartMode}" Value="Last7">
                                                            <Setter Property="Background" Value="{DynamicResource CyanBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource BlackBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{loc:Tr Tab_Stats}" Command="{Binding ShowStatsCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChartMode}" Value="Stats">
                                                            <Setter Property="Background" Value="{DynamicResource CyanBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource BlackBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{loc:Tr Tab_Calendar}" Command="{Binding ShowCalendarCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChartMode}" Value="Calendar">
                                                            <Setter Property="Background" Value="{DynamicResource CyanBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource BlackBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </WrapPanel>
                                </Grid>

                                <!-- ══ İSTATİSTİK ══ -->
                                <Grid Grid.Row="1" Margin="0,16,0,0">
                                    <Grid.Visibility>
                                        <Binding Path="IsStatsView">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </Grid.Visibility>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <ItemsControl Focusable="False" ItemsSource="{Binding StatTiles}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:StatTile}">
                                                <Grid Margin="0,0,10,10">
                                                    <local:ChamferFrame x:Name="TileFrame" Fill="{StaticResource PanelAltBrush}" Stroke="{DynamicResource CyanDimBrush}"
                                                                        StrokeThickness="1" Chamfer="8" Corners="TopLeft, BottomRight" />
                                                    <StackPanel Margin="12,8,10,10">
                                                        <TextBlock FontSize="11" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Label}" />
                                                        <TextBlock x:Name="TileValue" Margin="0,4,0,2" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource CyanBrush}"
                                                                   TextTrimming="CharacterEllipsis" Text="{Binding Value}" />
                                                        <TextBlock FontSize="11" Foreground="{StaticResource GreyBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Sub}" />
                                                    </StackPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Highlight}" Value="True">
                                                        <Setter TargetName="TileValue" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                                                        <Setter TargetName="TileFrame" Property="Stroke" Value="{DynamicResource YellowBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Grid.Row="1" Margin="0,6,0,8" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Text="{loc:Tr Stat_Weekdays}" />

                                    <!-- Haftanın günlerine göre ortalama (mini sütun grafiği, efektsiz) -->
                                    <ItemsControl Grid.Row="2" Focusable="False" ItemsSource="{Binding WeekdayStats}" ItemsPanel="{StaticResource SingleRowPanel}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:WeekdayStat}">
                                                <Grid Margin="6,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="{Binding EmptyHeight}" />
                                                        <RowDefinition Height="{Binding FillHeight}" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource AxisTextBrush}" Text="{Binding ValueText}" />
                                                    <Border x:Name="WdBar" Grid.Row="2" MaxWidth="46" Background="{DynamicResource CyanBrush}" />
                                                    <TextBlock x:Name="WdLabel" Grid.Row="3" Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="11"
                                                               Foreground="{DynamicResource AxisTextBrush}" Text="{Binding Label}" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsBest}" Value="True">
                                                        <Setter TargetName="WdBar" Property="Background" Value="{DynamicResource YellowBrush}" />
                                                        <Setter TargetName="WdLabel" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <!-- ══ TAKVİM ══ -->
                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.Visibility>
                                        <Binding Path="IsCalendarView">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </Grid.Visibility>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource SmallButton}" Content="◀" ToolTip="{loc:Tr Tip_PrevMonth}" Command="{Binding PreviousMonthCommand}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"
                                                   Foreground="{DynamicResource YellowBrush}" Text="{Binding CalendarTitle}" />
                                        <Button Grid.Column="2" Margin="0" Style="{StaticResource SmallButton}" Content="▶" ToolTip="{loc:Tr Tip_NextMonth}" Command="{Binding NextMonthCommand}" />
                                    </Grid>

                                    <ItemsControl Grid.Row="1" Margin="0,8,0,4" Focusable="False" ItemsSource="{Binding WeekdayHeaders}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="7" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Text="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 6×7 gün ızgarası; hücre = düğme (tıklayınca gün seçilir) -->
                                    <ItemsControl Grid.Row="2" Focusable="False" ItemsSource="{Binding CalendarCells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="7" Rows="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:CalendarCell}">
                                                <Button Margin="2" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                        Command="{Binding DataContext.SelectCalendarDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter />
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid>
                                                        <Border x:Name="CellBg" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" />
                                                        <Grid Margin="4,2,4,3">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid>
                                                                <TextBlock x:Name="DayNum" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AxisTextBrush}" Text="{Binding DayNumber}" />
                                                                <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource GreyBrush}" Text="{Binding HoursText}" />
                                                            </Grid>
                                                            <ItemsControl Grid.Row="1" Focusable="False" ItemsSource="{Binding PreviewItems}" ClipToBounds="True">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type models:CalendarItem}">
                                                                        <TextBlock x:Name="ItemText" FontSize="10" TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{DynamicResource CyanBrush}" Text="{Binding Title}" />
                                                                        <DataTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding Priority}" Value="HighPriority">
                                                                                <Setter TargetName="ItemText" Property="Foreground" Value="{StaticResource RedBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Priority}" Value="Decrypting">
                                                                                <Setter TargetName="ItemText" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsProjected}" Value="True">
                                                                                <Setter TargetName="ItemText" Property="Foreground" Value="{DynamicResource AxisTextBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                                <Setter TargetName="ItemText" Property="Foreground" Value="{StaticResource GreyBrush}" />
                                                                                <Setter TargetName="ItemText" Property="TextDecorations" Value="Strikethrough" />
                                                                            </DataTrigger>
                                                                        </DataTemplate.Triggers>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock x:Name="MoreText" Grid.Row="2" FontSize="9" Foreground="{StaticResource SubtleTextBrush}"
                                                                       Text="{Binding MoreCount, StringFormat='+{0}'}" />
                                                        </Grid>
                                                        <!-- Yoğunluk şeridi (o gün çalışılan saate göre) -->
                                                        <Border x:Name="HeatBar" Height="3" VerticalAlignment="Bottom" Background="Transparent" />
                                                    </Grid>
                                                </Button>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                        <Setter TargetName="CellBg" Property="Background" Value="{StaticResource PanelBrush}" />
                                                        <Setter TargetName="CellBg" Property="BorderBrush" Value="#0F151B" />
                                                        <Setter TargetName="DayNum" Property="Foreground" Value="{StaticResource GreyBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding MoreCount}" Value="0">
                                                        <Setter TargetName="MoreText" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Intensity}" Value="Low">
                                                        <Setter TargetName="HeatBar" Property="Background" Value="{DynamicResource CyanBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Intensity}" Value="Medium">
                                                        <Setter TargetName="HeatBar" Property="Background" Value="{DynamicResource YellowBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Intensity}" Value="High">
                                                        <Setter TargetName="HeatBar" Property="Background" Value="{StaticResource RedBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter TargetName="CellBg" Property="BorderBrush" Value="{DynamicResource YellowBrush}" />
                                                        <Setter TargetName="DayNum" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="CellBg" Property="BorderBrush" Value="{DynamicResource CyanBrush}" />
                                                        <Setter TargetName="CellBg" Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Seçili günün tüm görevleri -->
                                    <Grid Grid.Row="3" Margin="0,8,0,0" MaxHeight="96">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False" RenderOptions.EdgeMode="Aliased">
                                            <ItemsControl Focusable="False" ItemsSource="{Binding SelectedCalendarItems}" RenderOptions.EdgeMode="Unspecified">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:CalendarItem}">
                                                        <TextBlock x:Name="SelText" Margin="0,1" FontSize="13" Foreground="{DynamicResource CyanBrush}" TextTrimming="CharacterEllipsis">
                                                            <Run x:Name="SelGlyph" Text="◷ " /><Run Text="{Binding Display, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Priority}" Value="HighPriority">
                                                                <Setter TargetName="SelText" Property="Foreground" Value="{StaticResource RedBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Priority}" Value="Decrypting">
                                                                <Setter TargetName="SelText" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsProjected}" Value="True">
                                                                <Setter TargetName="SelGlyph" Property="Text" Value="↻ " />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter TargetName="SelText" Property="Foreground" Value="{StaticResource GreyBrush}" />
                                                                <Setter TargetName="SelText" Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter TargetName="SelGlyph" Property="Text" Value="✓ " />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock FontSize="13" Foreground="{StaticResource GreyBrush}" Text="{loc:Tr Cal_Empty}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedCalendarItems.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>

                                <!-- ══ SÜTUN GRAFİĞİ (30/7 gün) ══ -->
                                <Grid Grid.Row="1" Margin="0,30,0,0">
                                    <Grid.Visibility>
                                        <Binding Path="IsChartView">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </Grid.Visibility>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>

                                    <!-- Y ekseni etiketleri (4 eşit satır = ızgara çizgileriyle hizalı) -->
                                    <Grid Margin="0,0,8,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Margin="0,-8,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="11" Foreground="{DynamicResource AxisTextBrush}" Text="{Binding YAxisLabels[0]}" />
                                        <TextBlock Grid.Row="1" Margin="0,-8,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="11" Foreground="{DynamicResource AxisTextBrush}" Text="{Binding YAxisLabels[1]}" />
                                        <TextBlock Grid.Row="2" Margin="0,-8,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="11" Foreground="{DynamicResource AxisTextBrush}" Text="{Binding YAxisLabels[2]}" />
                                        <TextBlock Grid.Row="3" Margin="0,-8,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="11" Foreground="{DynamicResource AxisTextBrush}" Text="{Binding YAxisLabels[3]}" />
                                        <TextBlock Grid.Row="3" Margin="0,0,0,-8" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="11" Foreground="{DynamicResource AxisTextBrush}" Text="{Binding YAxisLabels[4]}" />
                                    </Grid>

                                    <Grid Grid.Column="1">
                                        <Grid IsHitTestVisible="False">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CyanFaintBrush}" />
                                            <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CyanFaintBrush}" />
                                            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CyanFaintBrush}" />
                                            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CyanFaintBrush}" />
                                        </Grid>

                                        <!-- Sütunlar: fare bu alandan çıkınca nişangâh kaybolur -->
                                        <ItemsControl Margin="6,0,6,2"
                                                      Focusable="False"
                                                      Background="Transparent"
                                                      MouseLeave="Chart_MouseLeave"
                                                      ItemsSource="{Binding ChartBars}"
                                                      ItemsPanel="{StaticResource SingleRowPanel}"
                                                      ItemTemplate="{StaticResource ChartBarTemplate}" />

                                        <Border BorderThickness="2,0,0,2" BorderBrush="{DynamicResource CyanBrush}" IsHitTestVisible="False" />
                                        <Path Margin="-5,-12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                              Fill="{DynamicResource CyanBrush}" Data="M0,10 L6,0 L12,10 Z" IsHitTestVisible="False" />
                                        <Path Margin="0,0,-12,-5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                              Fill="{DynamicResource CyanBrush}" Data="M0,0 L10,6 L0,12 Z" IsHitTestVisible="False" />
                                    </Grid>

                                    <ItemsControl Grid.Row="1" Grid.Column="1" Margin="6,8,6,0"
                                                  Focusable="False" IsHitTestVisible="False"
                                                  ItemsSource="{Binding ChartBars}"
                                                  ItemsPanel="{StaticResource SingleRowPanel}"
                                                  ItemTemplate="{StaticResource ChartLabelTemplate}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ═════════════ BİLDİRİMLER (sağ alt) ═════════════ -->
            <ItemsControl Width="520" Margin="0,0,46,46" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Focusable="False" ItemsSource="{Binding Toasts}" ItemTemplate="{StaticResource ToastTemplate}" />

        </Grid>

        <!--
            ═════════════ GÖREV DÜZENLEYİCİ ═════════════
            Karartma katmanı da kesik köşeli: şeffaf köşelerin arkasındaki masaüstü kararmaz.
            Esc tüm pencere için EscapeCommand ile yönetilir.
        -->
        <Grid Style="{StaticResource OverlayWhenEditor}">
            <Grid.InputBindings>
                <KeyBinding Key="Return" Command="{Binding SaveEditCommand}" />
            </Grid.InputBindings>
            <local:ChamferFrame Fill="{StaticResource BackdropBrush}" Chamfer="30" Corners="All" />
            <Grid>
                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
                </Grid.LayoutTransform>
                <Grid Width="680" HorizontalAlignment="Center" VerticalAlignment="Center" DataContext="{Binding Editor}">
                    <!-- Düzenleyici genel ölçeğe göre %10 daha büyük (okunabilirlik) -->
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                    </Grid.LayoutTransform>
                    <local:ChamferFrame Fill="{StaticResource PanelBrush}" Stroke="{DynamicResource YellowBrush}"
                                        StrokeThickness="2" Chamfer="20" Corners="TopLeft, BottomRight" />
                    <!-- %100 ölçekte de pencereye sığsın (700 × 1.1 + kenar); taşan içerik kayar -->
                    <ScrollViewer MaxHeight="700" Margin="28,22,28,22" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False" RenderOptions.EdgeMode="Aliased">
                        <StackPanel RenderOptions.EdgeMode="Unspecified">
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource YellowBrush}" Text="{Binding Heading}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Title}" />
                            <TextBox x:Name="EditorTitleBox" Style="{StaticResource NeonTextBox}" MaxLength="120"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- Notlar: çok satırlı; Enter satır ekler (kaydetmez), Kaydet butonu veya başka alanda Enter ile kaydedilir -->
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Notes}" />
                            <TextBox Style="{StaticResource NeonTextBox}" MaxLength="4000" Tag="{loc:Tr Notes_Hint}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Category}" />
                                    <TextBox Style="{StaticResource NeonTextBox}" MaxLength="40" Tag="{loc:Tr Add_CategoryHint}"
                                             Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Hours}" />
                                    <TextBox Style="{StaticResource NeonTextBox}" MaxLength="5"
                                             Text="{Binding HoursText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Priority}" />
                            <ListBox Style="{StaticResource ChipList}" ItemContainerStyle="{StaticResource PriorityChipStyle}"
                                     ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding SelectedPriority}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_DueDate}" />
                                    <TextBox Style="{StaticResource NeonTextBox}" MaxLength="10"
                                             Text="{Binding DueDateText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_DueTime}" />
                                    <TextBox Style="{StaticResource NeonTextBox}" MaxLength="5"
                                             Text="{Binding DueTimeText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Quick_Today}" Command="{Binding SetDueTodayCommand}" />
                                <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Quick_Tomorrow}" Command="{Binding SetDueTomorrowCommand}" />
                                <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Quick_NextWeek}" Command="{Binding SetDueNextWeekCommand}" />
                                <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Quick_Clear}" Command="{Binding ClearDueCommand}" />
                            </WrapPanel>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Recurrence}" />
                            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding RecurrenceOptions}" SelectedItem="{Binding SelectedRecurrence}" />

                            <!-- Seçili günler: Pzt..Paz çipleri + hızlı seçimler -->
                            <StackPanel Margin="0,4,0,0">
                                <StackPanel.Visibility>
                                    <Binding Path="IsDaysRecurrence">
                                        <Binding.Converter>
                                            <BooleanToVisibilityConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </StackPanel.Visibility>
                                <TextBlock Margin="0,4,0,6" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Text="{loc:Tr Rec_DaysLabel}" />
                                <ItemsControl Focusable="False" ItemsSource="{Binding DayToggles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,6,6" Style="{StaticResource DayChipButton}" Content="{Binding Label}"
                                                    Command="{Binding DataContext.Editor.ToggleDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel>
                                    <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Rec_Weekdays}" Command="{Binding SelectWeekdaysCommand}" />
                                    <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Rec_Weekend}" Command="{Binding SelectWeekendCommand}" />
                                    <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Rec_AllDays}" Command="{Binding SelectAllDaysCommand}" />
                                </WrapPanel>
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0" FontSize="12" FontStyle="Italic" Foreground="{StaticResource GreyBrush}" TextWrapping="Wrap" Text="{loc:Tr Rec_Note}">
                                <TextBlock.Visibility>
                                    <Binding Path="IsAnyRecurrence">
                                        <Binding.Converter>
                                            <BooleanToVisibilityConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </TextBlock.Visibility>
                            </TextBlock>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Reminder}" />
                            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding ReminderOptions}" SelectedItem="{Binding SelectedReminder}" />
                            <TextBlock Margin="0,2,0,0" FontSize="12" FontStyle="Italic" Foreground="{StaticResource GreyBrush}" TextWrapping="Wrap" Text="{loc:Tr Edit_ReminderNote}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Subtasks}" />
                            <ItemsControl Focusable="False" ItemsSource="{Binding Subtasks}" ItemTemplate="{StaticResource EditorSubtaskTemplate}" />
                            <TextBox Margin="0,8,0,0" Style="{StaticResource NeonTextBox}" MaxLength="120" Tag="{loc:Tr Subtask_Hint}"
                                     Text="{Binding NewSubtaskTitle, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddSubtaskCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <TextBlock Margin="0,14,0,0" FontSize="14" Foreground="{StaticResource RedBrush}" TextWrapping="Wrap"
                                       Text="{Binding ValidationError}" />

                            <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Margin="0,0,12,0" Style="{StaticResource ChamferButton}" Content="{loc:Tr Edit_Cancel}"
                                        Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Button Style="{StaticResource AddButton}" Content="{loc:Tr Edit_Save}"
                                        Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═════════════ ŞABLONLAR ═════════════ -->
        <Grid>
            <Grid.Visibility>
                <Binding Path="IsTemplatesOpen">
                    <Binding.Converter>
                        <BooleanToVisibilityConverter />
                    </Binding.Converter>
                </Binding>
            </Grid.Visibility>
            <local:ChamferFrame Fill="{StaticResource BackdropBrush}" Chamfer="30" Corners="All" />
            <Grid>
                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
                </Grid.LayoutTransform>
                <Grid Width="680" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <local:ChamferFrame Fill="{StaticResource PanelBrush}" Stroke="{DynamicResource YellowBrush}"
                                        StrokeThickness="2" Chamfer="20" Corners="TopLeft, BottomRight" />
                    <StackPanel Margin="28,22,28,24">
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource YellowBrush}" Text="{loc:Tr Templates_Button}" />
                        <Rectangle Height="1" Margin="0,10,0,10" Fill="{DynamicResource YellowDimBrush}" />
                        <TextBlock FontSize="12" FontStyle="Italic" Foreground="{StaticResource GreyBrush}" TextWrapping="Wrap" Text="{loc:Tr Template_Help}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CreateTemplateCommand}" />
                            </Grid.InputBindings>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource NeonTextBox}" MaxLength="60" Tag="{loc:Tr Template_NameHint}"
                                     Text="{Binding NewTemplateName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource AddButton}"
                                    Content="{loc:Tr Template_Create}" Command="{Binding CreateTemplateCommand}" />
                        </Grid>

                        <ScrollViewer Margin="0,16,0,0" MaxHeight="360" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Focusable="False" RenderOptions.EdgeMode="Aliased">
                            <ItemsControl Focusable="False" ItemsSource="{Binding Templates}" RenderOptions.EdgeMode="Unspecified">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:TaskTemplate}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource CyanBrush}" TextTrimming="CharacterEllipsis">
                                                <Run Text="⧉ " /><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Foreground="{StaticResource GreyBrush}" FontSize="12" Text="{Binding Items.Count, Mode=OneWay, StringFormat='[{0}]'}" />
                                            </TextBlock>
                                            <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="{loc:Tr Template_Apply}"
                                                    Command="{Binding DataContext.ApplyTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="2" Style="{StaticResource DeleteIconButton}" Content="✕" ToolTip="{loc:Tr Tip_Delete}"
                                                    Command="{Binding DataContext.DeleteTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource GreyBrush}" Text="{loc:Tr Templates_Empty}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Templates.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Margin="0,18,0,0" HorizontalAlignment="Right" Style="{StaticResource ChamferButton}"
                                Content="{loc:Tr Btn_Close}" Command="{Binding CloseTemplatesCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═════════════ AYARLAR ═════════════ -->
        <Grid>
            <Grid.Visibility>
                <Binding Path="IsSettingsOpen">
                    <Binding.Converter>
                        <BooleanToVisibilityConverter />
                    </Binding.Converter>
                </Binding>
            </Grid.Visibility>
            <local:ChamferFrame Fill="{StaticResource BackdropBrush}" Chamfer="30" Corners="All" />
            <Grid>
                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
                </Grid.LayoutTransform>
                <Grid Width="940" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <local:ChamferFrame Fill="{StaticResource PanelBrush}" Stroke="{DynamicResource CyanBrush}"
                                        StrokeThickness="2" Chamfer="20" Corners="TopLeft, BottomRight" />
                    <StackPanel Margin="28,22,28,24">
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource CyanBrush}">
                            <Run Text="⚙ " /><Run Text="{loc:Tr Settings_Title}" />
                        </TextBlock>
                        <Rectangle Height="1" Margin="0,10,0,0" Fill="{DynamicResource CyanDimBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Sol: görünüm -->
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Language}" />
                                <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguageOption}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Scale}" />
                                <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding ScaleOptions}" SelectedItem="{Binding SelectedScaleOption}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Theme}" />
                                <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeOption}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Sound}" />
                                <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding SelectedSoundOption}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Focus}" />
                                <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding FocusLengthOptions}" SelectedItem="{Binding SelectedFocusLengthOption}" />
                            </StackPanel>

                            <!-- Sağ: sistem -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Tray}" />
                                <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding SelectedTrayOption}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Startup}" />
                                <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding SelectedStartupOption}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Updates}" />
                                <TextBlock FontSize="13" Foreground="{DynamicResource AxisTextBrush}" TextWrapping="Wrap">
                                    <Run Text="{Binding VersionText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding UpdateStatusText, Mode=OneWay}" />
                                </TextBlock>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Update_Check}" Command="{Binding CheckUpdatesCommand}" />
                                    <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Update_Open}" Command="{Binding OpenReleasePageCommand}">
                                        <Button.Visibility>
                                            <Binding Path="HasUpdate">
                                                <Binding.Converter>
                                                    <BooleanToVisibilityConverter />
                                                </Binding.Converter>
                                            </Binding>
                                        </Button.Visibility>
                                    </Button>
                                </WrapPanel>
                                <TextBlock Margin="0,8,0,4" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Text="{loc:Tr Settings_AutoUpdate}" />
                                <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding SelectedAutoUpdateOption}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Shortcuts}" />
                                <TextBlock FontSize="13" LineHeight="20" Foreground="{DynamicResource AxisTextBrush}" TextWrapping="Wrap" Text="{loc:Tr Shortcuts_Text}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_DataPath}" />
                        <TextBox Style="{StaticResource NeonTextBox}" FontSize="12" IsReadOnly="True" Text="{Binding DataFilePath, Mode=OneWay}" />

                        <Button Margin="0,22,0,0" HorizontalAlignment="Right" Style="{StaticResource ChamferButton}"
                                Content="{loc:Tr Btn_Close}" Command="{Binding CloseSettingsCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
