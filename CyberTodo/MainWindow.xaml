<Window x:Class="CyberTodo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:local="clr-namespace:CyberTodo"
        xmlns:views="clr-namespace:CyberTodo.Views"
        xmlns:models="clr-namespace:CyberTodo.Models"
        xmlns:loc="clr-namespace:CyberTodo.Services"
        mc:Ignorable="po"
        Title="CALABATICA"
        Icon="pack://application:,,,/CALABATICA;component/Assets/calabatica.ico"
        Width="1440" Height="860" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#000000"
        Foreground="#00F0FF"
        FontFamily="Cascadia Mono, Consolas"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Standart başlık çubuğu yok; kenarlardan yeniden boyutlandırma WindowChrome ile korunur. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Klavye kısayolları (Ctrl+N / Ctrl+F odak işlemleri code-behind'da) -->
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Key="M" Modifiers="Control" Command="{Binding ToggleMiniModeCommand}" />
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <DataTemplate x:Key="ActiveTaskTemplate" DataType="{x:Type models:CyberTask}">
            <!-- Sürükle-bırak: satır bırakma hedefi; tutamaç (⠿) veya başlıktan sürüklenir -->
            <Grid x:Name="Row" Margin="0,0,10,20" Background="Transparent"
                  AllowDrop="True" DragOver="Row_DragOver" Drop="Row_Drop" MouseLeftButtonDown="Row_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Klavye seçimi: solda dikey çizgi + hafif zemin (Opacity değil renk; kesirli ölçekte iz bırakmaz) -->
                <Border x:Name="SelectionMark" Grid.RowSpan="4" Grid.ColumnSpan="4" Margin="-8,-6,-4,-8"
                        Background="{DynamicResource CyanFaintBrush}" BorderBrush="{DynamicResource YellowBrush}" BorderThickness="3,0,0,0"
                        Visibility="Collapsed" IsHitTestVisible="False" />

                <!-- Bırakma çizgisi: sürüklenen görev bu satırın üstüne gelecek -->
                <Border x:Name="DropLine" Grid.ColumnSpan="4" Height="3" Margin="0,-12,0,0" VerticalAlignment="Top"
                        Background="{DynamicResource CyanBrush}" Visibility="Collapsed" IsHitTestVisible="False" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="DragHandle" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="16"
                               Foreground="{DynamicResource GreyBrush}" Text="⠿" Cursor="SizeAll" Background="Transparent"
                               ToolTip="{loc:Tr Tip_Drag}"
                               PreviewMouseLeftButtonDown="DragSource_MouseDown" MouseMove="DragSource_MouseMove" />
                    <Button x:Name="CheckBtn"
                            Style="{StaticResource TaskCheckButton}"
                            Margin="0,0,18,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:Tr Tip_Complete}" ToolTip="{loc:Tr Tip_Complete}"
                            Command="{Binding DataContext.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </StackPanel>

                <TextBlock x:Name="TitleText"
                           Grid.Column="1"
                           Background="Transparent"
                           PreviewMouseLeftButtonDown="DragSource_MouseDown" MouseMove="DragSource_MouseMove"
                           VerticalAlignment="Center"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource CyanBrush}"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Code, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Title, Mode=OneWay}" />
                </TextBlock>

                <TextBlock x:Name="StatusTag"
                           Grid.Column="2"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="{loc:Tr Prio_Active}"
                           Foreground="{StaticResource GreenBrush}" />

                <StackPanel x:Name="Actions" Grid.Column="3" Margin="8,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="FocusBtn" Style="{StaticResource RowIconButton}" Content="▶" AutomationProperties.Name="{loc:Tr Tip_Focus}" ToolTip="{loc:Tr Tip_Focus}"
                            Command="{Binding DataContext.StartFocusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <Button Style="{StaticResource RowIconButton}" Content="✎" AutomationProperties.Name="{loc:Tr Tip_Edit}" ToolTip="{loc:Tr Tip_Edit}"
                            Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <Button Style="{StaticResource RowDeleteButton}" Content="✕" AutomationProperties.Name="{loc:Tr Tip_Delete}" ToolTip="{loc:Tr Tip_Delete}"
                            Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </StackPanel>

                <!-- Meta satırı: kategori, son tarih, tekrar, alt görev sayacı (boş olanlar gizli) -->
                <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                    <Border x:Name="CategoryChip" Margin="0,6,10,0" Padding="7,1" BorderThickness="1" BorderBrush="{DynamicResource CyanDimBrush}">
                        <TextBlock FontSize="12" Foreground="{DynamicResource AxisTextBrush}">
                            <Run Text="#" /><Run Text="{Binding Category, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <TextBlock x:Name="DueChip" Margin="0,6,10,0" FontSize="13" Foreground="{DynamicResource AxisTextBrush}">
                        <Run Text="⏱ " /><Run Text="{Binding DueText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock x:Name="RecurChip" Margin="0,6,10,0" FontSize="13" Foreground="{DynamicResource AxisTextBrush}">
                        <Run Text="↻ " /><Run Text="{Binding RecurrenceText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock x:Name="ReminderChip" Margin="0,6,10,0" FontSize="13" Foreground="{DynamicResource AxisTextBrush}" Text="⏰" Visibility="Collapsed" />
                    <TextBlock x:Name="TrackedChip" Margin="0,6,10,0" FontSize="13" Foreground="{DynamicResource YellowBrush}">
                        <Run Text="◉ " /><Run Text="{Binding TrackedText, Mode=OneWay}" />
                    </TextBlock>
                    <Button x:Name="SubtaskChip"
                            Margin="0,4,10,0"
                            Style="{StaticResource IconButton}"
                            Width="Auto"
                            Padding="6,0"
                            FontSize="13"
                            Foreground="{DynamicResource AxisTextBrush}"
                            AutomationProperties.Name="{loc:Tr Tip_Subtasks}" ToolTip="{loc:Tr Tip_Subtasks}"
                            Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <TextBlock Margin="4,0">
                            <Run x:Name="ExpandGlyph" Text="▸ " /><Run x:Name="NotesGlyph" Text="✎ " /><Run x:Name="SubtaskGlyph" Text="☑ " /><Run Text="{Binding SubtaskSummary, Mode=OneWay}" />
                        </TextBlock>
                    </Button>
                </WrapPanel>

                <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="54" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="ProgressBarItem"
                                 Style="{StaticResource NeonProgress}"
                                 Value="{Binding Progress, Mode=OneWay}"
                                 Cursor="Hand"
                                 ToolTip="{loc:Tr Tip_Progress}"
                                 MouseLeftButtonDown="Progress_MouseLeftButtonDown" />
                    <TextBlock x:Name="PercentText"
                               Grid.Column="1"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource CyanBrush}"
                               Text="{Binding Progress, StringFormat={}{0:0}%}" />
                </Grid>

                <!-- Genişletilmiş ayrıntılar: notlar + alt görevler -->
                <StackPanel x:Name="DetailsPanel" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="4,6,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="NotesText" Margin="0,2,0,4" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}"
                               TextWrapping="Wrap" Text="{Binding Notes}" />
                    <ItemsControl Focusable="False" ItemsSource="{Binding Subtasks}" ItemTemplate="{StaticResource SubtaskRowTemplate}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="HighPriority">
                    <Setter TargetName="CheckBtn" Property="BorderBrush" Value="{StaticResource RedBrush}" />
                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource RedBrush}" />
                    <Setter TargetName="StatusTag" Property="Text" Value="{loc:Tr Prio_High}" />
                    <Setter TargetName="StatusTag" Property="Foreground" Value="{StaticResource RedBrush}" />
                    <Setter TargetName="ProgressBarItem" Property="Foreground" Value="{StaticResource RedBrush}" />
                    <Setter TargetName="PercentText" Property="Foreground" Value="{StaticResource RedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="Decrypting">
                    <Setter TargetName="CheckBtn" Property="BorderBrush" Value="{DynamicResource YellowBrush}" />
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                    <Setter TargetName="StatusTag" Property="Text" Value="{loc:Tr Prio_Decrypt}" />
                    <Setter TargetName="StatusTag" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                    <Setter TargetName="ProgressBarItem" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                    <Setter TargetName="PercentText" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding Category}" Value="{x:Null}">
                    <Setter TargetName="CategoryChip" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DueState}" Value="None">
                    <Setter TargetName="DueChip" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DueState}" Value="Today">
                    <Setter TargetName="DueChip" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DueState}" Value="Overdue">
                    <Setter TargetName="DueChip" Property="Foreground" Value="{StaticResource RedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Recurrence}" Value="None">
                    <Setter TargetName="RecurChip" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ReminderFired}" Value="False">
                    <Setter TargetName="ReminderChip" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ReminderMinutesBefore}" Value="{x:Null}">
                    <Setter TargetName="ReminderChip" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasDetails}" Value="False">
                    <Setter TargetName="SubtaskChip" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasNotes}" Value="False">
                    <Setter TargetName="NotesGlyph" Property="Text" Value="" />
                    <Setter TargetName="NotesText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasSubtasks}" Value="False">
                    <Setter TargetName="SubtaskGlyph" Property="Text" Value="" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="DetailsPanel" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ExpandGlyph" Property="Text" Value="▾ " />
                </DataTrigger>
                <DataTrigger Binding="{Binding TrackedText}" Value="">
                    <Setter TargetName="TrackedChip" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFocused}" Value="True">
                    <Setter TargetName="FocusBtn" Property="Content" Value="■" />
                    <Setter TargetName="FocusBtn" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                    <Setter TargetName="FocusBtn" Property="ToolTip" Value="{loc:Tr Tip_StopFocus}" />
                    <Setter TargetName="FocusBtn" Property="AutomationProperties.Name" Value="{loc:Tr Tip_StopFocus}" />
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="DragHandle" Property="Foreground" Value="{DynamicResource CyanBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="DropLine" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDropAfter}" Value="True">
                    <Setter TargetName="DropLine" Property="VerticalAlignment" Value="Bottom" />
                    <Setter TargetName="DropLine" Property="Grid.Row" Value="3" />
                    <Setter TargetName="DropLine" Property="Margin" Value="0,0,0,-12" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Grafik sütunu: nişangâh + beyaz çerçeve SADECE fare üzerindeyken -->
        <DataTemplate x:Key="ChartBarTemplate" DataType="{x:Type models:ChartBar}">
            <Grid Background="Transparent" Cursor="Hand" MouseEnter="Bar_MouseEnter">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding EmptyHeight}" />
                    <RowDefinition Height="{Binding FillHeight}" />
                </Grid.RowDefinitions>
                <Border x:Name="BarRect"
                        Grid.Row="1"
                        Margin="3,0"
                        MaxWidth="38"
                        Background="{DynamicResource CyanBrush}"
                        BorderBrush="Transparent"
                        BorderThickness="0" />
                <!-- Canvas boyutu 0: halka sütun tepesinde ortalanır ve kırpılmaz -->
                <Canvas x:Name="Reticle"
                        Grid.Row="1"
                        Width="0" Height="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <Ellipse Canvas.Left="-14" Canvas.Top="-14" Width="28" Height="28"
                             Stroke="{DynamicResource YellowBrush}" StrokeThickness="1.5" />
                    <Path Stroke="{DynamicResource YellowBrush}" StrokeThickness="1.5"
                          Data="M-20,0 L-9,0 M9,0 L20,0 M0,-20 L0,-9" />
                </Canvas>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Intensity}" Value="None">
                    <Setter TargetName="BarRect" Property="Background" Value="{DynamicResource GreyBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="Medium">
                    <Setter TargetName="BarRect" Property="Background" Value="{DynamicResource YellowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Intensity}" Value="High">
                    <Setter TargetName="BarRect" Property="Background" Value="{StaticResource RedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHovered}" Value="True">
                    <Setter TargetName="BarRect" Property="BorderBrush" Value="{StaticResource WhiteBrush}" />
                    <Setter TargetName="BarRect" Property="BorderThickness" Value="2" />
                    <Setter TargetName="Reticle" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="EditorSubtaskTemplate" DataType="{x:Type models:SubTask}">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource MiniCheckButton}" AutomationProperties.Name="{Binding Title}" VerticalAlignment="Center" Click="EditorSubtaskToggle_Click">
                    <Path x:Name="SubCheck" Data="M3,9 L7,13 L14,4" Stroke="{DynamicResource CyanBrush}" StrokeThickness="2" Visibility="Hidden" />
                </Button>
                <TextBlock x:Name="SubTitle" Grid.Column="1" Margin="10,0" VerticalAlignment="Center" FontSize="14"
                           Foreground="{DynamicResource CyanBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                <Button Grid.Column="2" Style="{StaticResource DeleteIconButton}" Content="✕" AutomationProperties.Name="{loc:Tr Tip_Delete}" ToolTip="{loc:Tr Tip_Delete}"
                        Command="{Binding DataContext.Editor.RemoveSubtaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="SubCheck" Property="Visibility" Value="Visible" />
                    <Setter TargetName="SubTitle" Property="Foreground" Value="{DynamicResource GreyBrush}" />
                    <Setter TargetName="SubTitle" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!--
            Ana dış çerçeve: pencere kenarına oturur, 4 köşe 45° kesik (simetrik), kesik çizgi sarı.
            Kesik çizginin dışındaki üçgenler cyan dolgu (CornerFill) → pencere tamamen opak kalır,
            şeffaf pencere (AllowsTransparency) gerekmez; GPU render yolu korunur.
            Ölçeklenmez → kenar her ölçekte sabit 2px.
        -->
        <local:ChamferFrame Fill="{StaticResource BlackBrush}"
                            Stroke="{DynamicResource YellowBrush}"
                            CornerFill="{DynamicResource CyanBrush}"
                            StrokeThickness="2"
                            Chamfer="30"
                            Corners="All" />
        <Rectangle Width="4" Height="70" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource YellowBrush}" />
        <Rectangle Width="4" Height="70" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{DynamicResource YellowBrush}" />

        <!--
            İçerik ölçeği: pencere boyutu aynı kalır, tüm yapı UiScale oranında küçülür (varsayılan %85).
            Margin dönüşümün DIŞINDA uygulanır (ölçeklenmez): başlık hiçbir ölçekte kesik köşeye yaklaşmaz
            ve sol/sağ boşluk eşit kalır.
        -->
        <Grid x:Name="ScaleHost" Margin="40,18,40,24">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
            </Grid.LayoutTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ═════════════ ÜST BAR (sürüklenebilir) ═════════════ -->
                <Grid x:Name="HeaderBar" Background="{StaticResource HitTestBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Odak (Pomodoro) göstergesi: başlığın ortasında, sadece çalışırken -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                        <Grid.Visibility>
                            <Binding Path="Focus.IsRunning">
                                <Binding.Converter>
                                    <BooleanToVisibilityConverter />
                                </Binding.Converter>
                            </Binding>
                        </Grid.Visibility>
                        <local:ChamferFrame Fill="{StaticResource PanelAltBrush}" Stroke="{DynamicResource YellowBrush}"
                                            StrokeThickness="1.5" Chamfer="8" Corners="TopLeft, BottomRight" />
                        <Grid Margin="14,6,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource YellowBrush}" MaxWidth="360" TextTrimming="CharacterEllipsis">
                                <Run Text="◉ " /><Run Text="{loc:Tr Focus_Label}" /><Run Text=" · " /><Run Text="{Binding Focus.Task.Code, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Focus.Task.Title, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource YellowBrush}" Text="{Binding Focus.RemainingText}" />
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="■" Foreground="{DynamicResource YellowBrush}"
                                    AutomationProperties.Name="{loc:Tr Tip_StopFocus}" ToolTip="{loc:Tr Tip_StopFocus}" Command="{Binding StopFocusCommand}" />
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Height="5" Margin="0,5,0,0" Style="{StaticResource NeonProgress}"
                                         Foreground="{DynamicResource YellowBrush}" Maximum="1" Value="{Binding Focus.Progress, Mode=OneWay}" />
                        </Grid>
                    </Grid>

                    <!-- Mola göstergesi: odak bitince (cyan; odakla aynı yerde, ikisi aynı anda görünmez) -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                        <Grid.Visibility>
                            <Binding Path="Focus.IsOnBreak">
                                <Binding.Converter>
                                    <BooleanToVisibilityConverter />
                                </Binding.Converter>
                            </Binding>
                        </Grid.Visibility>
                        <local:ChamferFrame Fill="{StaticResource PanelAltBrush}" Stroke="{DynamicResource CyanBrush}"
                                            StrokeThickness="1.5" Chamfer="8" Corners="TopLeft, BottomRight" />
                        <Grid Margin="14,6,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="BreakLabel" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource CyanBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{loc:Tr Break_Label}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Focus.IsLongBreak}" Value="True">
                                                <Setter Property="Text" Value="{loc:Tr Break_Long}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource CyanBrush}" Text="{Binding Focus.BreakRemainingText}" />
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="⏭" Foreground="{DynamicResource CyanBrush}"
                                    AutomationProperties.Name="{loc:Tr Tip_SkipBreak}" ToolTip="{loc:Tr Tip_SkipBreak}" Command="{Binding SkipBreakCommand}" />
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Height="5" Margin="0,5,0,0" Style="{StaticResource NeonProgress}"
                                         Foreground="{DynamicResource CyanBrush}" Maximum="1" Value="{Binding Focus.BreakProgress, Mode=OneWay}" />
                        </Grid>
                    </Grid>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="32" FontWeight="Bold" Foreground="{DynamicResource YellowBrush}" TextTrimming="CharacterEllipsis">
                                <!-- Glow #1 (izin verilen tekil eleman) -->
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="{DynamicResource PrimaryColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.85" />
                                </TextBlock.Effect>
                                <!-- Sürüm exe'den okunur; yayın derlemesinde GitHub etiketinden gelir -->
                                <Run Text="CALABATICA" /><Run Text=" " /><Run FontSize="16" Foreground="{DynamicResource YellowDimBrush}" Text="{Binding VersionText, Mode=OneWay}" />
                            </TextBlock>
                            <!-- GitHub'da daha yeni sürüm varsa: ▲ v1.1 (tıkla → yayın sayfası) -->
                            <Button Margin="12,0,0,4" VerticalAlignment="Bottom" Style="{StaticResource SmallButton}"
                                    Content="{Binding UpdateBadgeText}" AutomationProperties.Name="{loc:Tr Tip_UpdateAvailable}" ToolTip="{loc:Tr Tip_UpdateAvailable}"
                                    Command="{Binding OpenReleasePageCommand}">
                                <Button.Visibility>
                                    <Binding Path="HasUpdate">
                                        <Binding.Converter>
                                            <BooleanToVisibilityConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </Button.Visibility>
                            </Button>
                        </StackPanel>

                        <StackPanel Margin="2,6,0,0" Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock MaxWidth="900" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource RedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding ErrorMessage, StringFormat='!! {0}'}"
                                       ToolTip="{Binding ErrorMessage}" />
                            <Button Style="{StaticResource CaptionCloseButton}" Width="26" Height="20" Margin="10,0,0,0" FontSize="10"
                                    Content="✕" AutomationProperties.Name="{loc:Tr Tip_Dismiss}" ToolTip="{loc:Tr Tip_Dismiss}" Command="{Binding DismissErrorCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Başlıkla aynı dikey eksende (simetri) -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionButton}" Content="?" AutomationProperties.Name="{loc:Tr Tip_Help}" ToolTip="{loc:Tr Tip_Help}" Command="{Binding OpenOnboardingCommand}" />
                        <Button Style="{StaticResource CaptionButton}" Content="⇲" AutomationProperties.Name="{loc:Tr Tip_Mini}" ToolTip="{loc:Tr Tip_Mini}" Command="{Binding ToggleMiniModeCommand}" />
                        <Button Style="{StaticResource CaptionButton}" Content="⚙" AutomationProperties.Name="{loc:Tr Tip_Settings}" ToolTip="{loc:Tr Tip_Settings}" Command="{Binding OpenSettingsCommand}" />
                        <Button Style="{StaticResource CaptionButton}" Content="─" AutomationProperties.Name="{loc:Tr Tip_Minimize}" ToolTip="{loc:Tr Tip_Minimize}" Click="Minimize_Click" />
                        <Button Style="{StaticResource CaptionCloseButton}" Content="✕" AutomationProperties.Name="{loc:Tr Tip_Close}" ToolTip="{loc:Tr Tip_Close}" Click="Close_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,18">
                    <Rectangle Height="1" Fill="{DynamicResource YellowDimBrush}" />
                    <Rectangle Width="100" Height="3" HorizontalAlignment="Left" Fill="{DynamicResource YellowBrush}" />
                    <Rectangle Width="100" Height="3" HorizontalAlignment="Right" Fill="{DynamicResource YellowBrush}" />
                </Grid>

                <!-- ═════════════ İÇERİK ═════════════ -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.12*" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ───────── SOL: GÖREVLER ───────── -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource WhiteBrush}" Text="{loc:Tr Tasks_Header}" />
                            <Grid Margin="0,8,0,0">
                                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" />
                                <Rectangle Width="48" Height="3" HorizontalAlignment="Left" Fill="{DynamicResource SubtleTextBrush}" />
                            </Grid>
                        </StackPanel>

                        <!-- Hızlı görev ekleme (Enter = + EKLE) -->
                        <Grid Grid.Row="1" Margin="0,14,0,14">
                            <Grid.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddTaskCommand}" />
                            </Grid.InputBindings>
                            <local:ChamferFrame Fill="{StaticResource PanelBrush}" Stroke="{DynamicResource CyanFaintBrush}"
                                                StrokeThickness="1" Chamfer="12" Corners="TopRight, BottomLeft" />
                            <Grid Margin="16,10,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Margin="0,0,0,5" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Text="{loc:Tr Add_TitleLabel}" />
                                <TextBlock Grid.Column="1" Margin="12,0,0,5" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Text="{loc:Tr Add_CategoryLabel}" />
                                <TextBlock Grid.Column="2" Margin="12,0,0,5" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Text="{loc:Tr Add_HoursLabel}" />

                                <TextBox x:Name="TaskTitleBox" Grid.Row="1" Style="{StaticResource NeonTextBox}" MaxLength="200"
                                         Tag="{loc:Tr Add_TitleHint}" ToolTip="{loc:Tr QuickAdd_Help}"
                                         Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource NeonTextBox}" MaxLength="40"
                                         Tag="{loc:Tr Add_CategoryHint}"
                                         Text="{Binding NewTaskCategory, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="1" Grid.Column="2" Width="80" Margin="12,0,0,0" Style="{StaticResource NeonTextBox}" MaxLength="5"
                                         HorizontalContentAlignment="Center"
                                         Text="{Binding NewTaskHours, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Row="1" Grid.Column="3" Margin="12,0,0,0" Style="{StaticResource AddButton}"
                                        Content="{loc:Tr Add_Button}" Command="{Binding AddTaskCommand}" />

                                <!-- Hızlı ekleme komutlarının canlı önizlemesi -->
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Margin="2,6,0,0" FontSize="13" Foreground="{DynamicResource YellowBrush}"
                                           TextTrimming="CharacterEllipsis" Text="{Binding QuickAddPreview}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding QuickAddPreview}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ListBox Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0"
                                         Style="{StaticResource ChipList}"
                                         ItemContainerStyle="{StaticResource PriorityChipStyle}"
                                         ItemsSource="{Binding PriorityOptions}"
                                         SelectedItem="{Binding SelectedPriorityOption}" />
                                <StackPanel Grid.Row="3" Grid.Column="3" Margin="12,10,0,6" VerticalAlignment="Top" HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                    <!-- Son işlemi geri al (ekle/tamamla/düzenle/taşı/sil); ipucu neyin geri alınacağını söyler -->
                                    <Button Margin="0,0,8,0" Style="{StaticResource SmallButton}" Content="{loc:Tr Btn_Undo}"
                                            Command="{Binding UndoCommand}" ToolTip="{Binding UndoHint}"
                                            ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding UndoHint}" />
                                    <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Templates_Button}"
                                            Command="{Binding OpenTemplatesCommand}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Arama + sıralama + kategori filtresi -->
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="SearchBox" Style="{StaticResource NeonTextBox}" Tag="{loc:Tr Search_Hint}" VerticalAlignment="Top"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Grid.Column="1" Margin="14,4,0,0" Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Margin="0,6,10,0" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Text="{loc:Tr Sort_Label}" />
                                <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" />
                            </StackPanel>
                            <!-- Akıllı listeler: TÜMÜ / BUGÜN / YAKLAŞAN / GECİKMİŞ (sayaçlı) -->
                            <ListBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                     Style="{StaticResource ChipList}"
                                     ItemsSource="{Binding SmartViews}"
                                     SelectedItem="{Binding SelectedSmartView}" />

                            <ListBox Grid.Row="2" Grid.ColumnSpan="2" Margin="0,2,0,0"
                                     Style="{StaticResource ChipList}"
                                     ItemsSource="{Binding CategoryFilters}"
                                     SelectedItem="{Binding SelectedCategoryFilter}">
                                <ListBox.Visibility>
                                    <Binding Path="HasCategories">
                                        <Binding.Converter>
                                            <BooleanToVisibilityConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </ListBox.Visibility>
                            </ListBox>

                            <!-- Kayıtlı görünümler: ★ kaydet + çipler (ad otomatik: "#iş · BUGÜN · “rapor”") -->
                            <WrapPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                <Button Margin="0,0,8,6" Style="{StaticResource SmallButton}" Content="{loc:Tr Filter_Save}"
                                        ToolTip="{loc:Tr Tip_SaveFilter}" AutomationProperties.Name="{loc:Tr Tip_SaveFilter}"
                                        ToolTipService.ShowOnDisabled="True" Command="{Binding SaveCurrentFilterCommand}" />
                                <ItemsControl Focusable="False" ItemsSource="{Binding SavedFilters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SavedFilter}">
                                            <StackPanel Margin="0,0,8,6" Orientation="Horizontal">
                                                <Button x:Name="FilterChip" Style="{StaticResource SmallButton}" Margin="0" Content="{Binding Name}"
                                                        ToolTip="{loc:Tr Tip_ApplyFilter}" AutomationProperties.Name="{Binding Name}"
                                                        Command="{Binding DataContext.ApplySavedFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource IconButton}" Width="20" Content="✕" FontSize="11"
                                                        ToolTip="{loc:Tr Tip_DeleteFilter}" AutomationProperties.Name="{loc:Tr Tip_DeleteFilter}"
                                                        Command="{Binding DataContext.DeleteSavedFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="FilterChip" Property="Background" Value="{DynamicResource CyanBrush}" />
                                                    <Setter TargetName="FilterChip" Property="Foreground" Value="{StaticResource BlackBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                        </Grid>

                        <!-- Aktif görevler -->
                        <Grid Grid.Row="3">
                            <!-- Sanal liste; satırların altındaki boş alana bırakılırsa listenin sonuna taşınır -->
                            <ItemsControl x:Name="ActiveList" Style="{StaticResource VirtualList}" Focusable="True" FocusVisualStyle="{x:Null}"
                                          ItemsSource="{Binding ActiveView}" ItemTemplate="{StaticResource ActiveTaskTemplate}"
                                          AllowDrop="True" DragOver="ListEnd_DragOver" Drop="ListEnd_Drop" />
                            <TextBlock Margin="46,6,0,0" FontSize="15" Foreground="{DynamicResource GreyBrush}" Text="{loc:Tr Empty_Active}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveView.IsEmpty}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Tamamlananlar -->
                        <StackPanel Grid.Row="4" Margin="0,10,0,12">
                            <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource GreyBrush}">
                                <Run Text="{loc:Tr Completed_Header}" /><Run Text="{Binding CompletedTasks.Count, Mode=OneWay, StringFormat=' [{0}]'}" />
                            </TextBlock>
                            <Rectangle Height="1" Margin="0,8,0,0" Fill="{StaticResource DividerBrush}" />
                        </StackPanel>

                        <ItemsControl Grid.Row="5" MaxHeight="170" Style="{StaticResource VirtualList}"
                                      ItemsSource="{Binding CompletedView}" ItemTemplate="{StaticResource CompletedTaskTemplate}" />
                    </Grid>

                    <!-- ───────── SAĞ: LOG + GRAFİK ───────── -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="250" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- AKTİVİTE LOGU: çift cyan çerçeve + glow #2 (izin verilen tekil eleman) -->
                        <Grid Margin="0,2,0,0">
                            <local:ChamferFrame Fill="{StaticResource PanelBrush}" Stroke="{DynamicResource CyanBrush}"
                                                StrokeThickness="2" Chamfer="20" Corners="TopLeft, BottomRight">
                                <local:ChamferFrame.Effect>
                                    <DropShadowEffect Color="{DynamicResource SecondaryColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.7" />
                                </local:ChamferFrame.Effect>
                            </local:ChamferFrame>
                            <local:ChamferFrame Margin="6" Stroke="{DynamicResource CyanDimBrush}" StrokeThickness="1" Chamfer="16"
                                                Corners="TopLeft, BottomRight" IsHitTestVisible="False" />

                            <Grid Margin="24,16,24,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource CyanBrush}"
                                           TextTrimming="CharacterEllipsis" Text="{Binding SelectedDayTitle}" />
                                <Rectangle Grid.Row="1" Height="1" Margin="0,8,0,8" Fill="{DynamicResource CyanDimBrush}" />

                                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False" RenderOptions.EdgeMode="Aliased">
                                    <ItemsControl ItemsSource="{Binding SelectedDay.Entries}" ItemTemplate="{StaticResource LogEntryTemplate}" Focusable="False" RenderOptions.EdgeMode="Unspecified" />
                                </ScrollViewer>
                                <TextBlock Grid.Row="2" FontSize="14" Foreground="{DynamicResource GreyBrush}" Text="{loc:Tr Empty_Log}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDay.Entries.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Row="3" Margin="0,8,0,0" FontSize="15" Foreground="{DynamicResource CyanBrush}" Text="{Binding SelectedDaySummary}" />
                            </Grid>
                        </Grid>

                        <TextBlock Grid.Row="1" Margin="0,22,0,12" FontSize="26" FontWeight="Bold" Foreground="{StaticResource WhiteBrush}" Text="{loc:Tr Chart_Header}" />

                        <!-- Grafik paneli -->
                        <Grid Grid.Row="2">
                            <local:ChamferFrame Fill="{StaticResource PanelBrush}" Stroke="{DynamicResource CyanDimBrush}"
                                                StrokeThickness="1" Chamfer="16" Corners="BottomRight" />
                            <Grid Margin="14,12,22,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource CyanDimBrush}" />
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="{loc:Tr Tab_30}" Command="{Binding ShowLast30DaysCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChartMode}" Value="Last30">
                                                            <Setter Property="Background" Value="{DynamicResource CyanBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource BlackBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{loc:Tr Tab_7}" Command="{Binding ShowLast7DaysCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChartMode}" Value="Last7">
                                                            <Setter Property="Background" Value="{DynamicResource CyanBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource BlackBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{loc:Tr Tab_Stats}" Command="{Binding ShowStatsCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChartMode}" Value="Stats">
                                                            <Setter Property="Background" Value="{DynamicResource CyanBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource BlackBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{loc:Tr Tab_Calendar}" Command="{Binding ShowCalendarCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChartMode}" Value="Calendar">
                                                            <Setter Property="Background" Value="{DynamicResource CyanBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource BlackBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{loc:Tr Tab_Focus}" Command="{Binding ShowFocusCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChartMode}" Value="Focus">
                                                            <Setter Property="Background" Value="{DynamicResource CyanBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource BlackBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{loc:Tr Tab_Habits}" Command="{Binding ShowHabitsCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChartMode}" Value="Habits">
                                                            <Setter Property="Background" Value="{DynamicResource CyanBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource BlackBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </WrapPanel>
                                </Grid>

                                <!-- ══ İSTATİSTİK ══ -->
                                <views:StatsPanel Grid.Row="1" Margin="0,16,0,0">
                                    <views:StatsPanel.Visibility>
                                        <Binding Path="IsStatsView">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </views:StatsPanel.Visibility>
                                </views:StatsPanel>

                                <!-- ══ ODAK ══ -->
                                <views:FocusStatsPanel Grid.Row="1" Margin="0,16,0,0">
                                    <views:FocusStatsPanel.Visibility>
                                        <Binding Path="IsFocusView">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </views:FocusStatsPanel.Visibility>
                                </views:FocusStatsPanel>

                                <!-- ══ ALIŞKANLIKLAR ══ (tekrarlayan görev zincirleri: seri + son 28 gün şeridi) -->
                                <views:HabitsPanel Grid.Row="1" Margin="0,14,0,0">
                                    <views:HabitsPanel.Visibility>
                                        <Binding Path="IsHabitsView">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </views:HabitsPanel.Visibility>
                                </views:HabitsPanel>

                                <!-- ══ TAKVİM ══ -->
                                <views:CalendarPanel Grid.Row="1" Margin="0,12,0,0">
                                    <views:CalendarPanel.Visibility>
                                        <Binding Path="IsCalendarView">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </views:CalendarPanel.Visibility>
                                </views:CalendarPanel>

                                <!-- ══ SÜTUN GRAFİĞİ (30/7 gün) ══ -->
                                <Grid Grid.Row="1" Margin="0,30,0,0">
                                    <Grid.Visibility>
                                        <Binding Path="IsChartView">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </Grid.Visibility>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>

                                    <!-- Y ekseni etiketleri (4 eşit satır = ızgara çizgileriyle hizalı) -->
                                    <Grid Margin="0,0,8,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Margin="0,-8,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="11" Foreground="{DynamicResource AxisTextBrush}" Text="{Binding YAxisLabels[0]}" />
                                        <TextBlock Grid.Row="1" Margin="0,-8,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="11" Foreground="{DynamicResource AxisTextBrush}" Text="{Binding YAxisLabels[1]}" />
                                        <TextBlock Grid.Row="2" Margin="0,-8,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="11" Foreground="{DynamicResource AxisTextBrush}" Text="{Binding YAxisLabels[2]}" />
                                        <TextBlock Grid.Row="3" Margin="0,-8,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="11" Foreground="{DynamicResource AxisTextBrush}" Text="{Binding YAxisLabels[3]}" />
                                        <TextBlock Grid.Row="3" Margin="0,0,0,-8" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="11" Foreground="{DynamicResource AxisTextBrush}" Text="{Binding YAxisLabels[4]}" />
                                    </Grid>

                                    <Grid Grid.Column="1">
                                        <Grid IsHitTestVisible="False">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CyanFaintBrush}" />
                                            <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CyanFaintBrush}" />
                                            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CyanFaintBrush}" />
                                            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CyanFaintBrush}" />
                                        </Grid>

                                        <!-- Sütunlar: fare bu alandan çıkınca nişangâh kaybolur -->
                                        <ItemsControl Margin="6,0,6,2"
                                                      Focusable="False"
                                                      Background="Transparent"
                                                      MouseLeave="Chart_MouseLeave"
                                                      ItemsSource="{Binding ChartBars}"
                                                      ItemsPanel="{StaticResource SingleRowPanel}"
                                                      ItemTemplate="{StaticResource ChartBarTemplate}" />

                                        <Border BorderThickness="2,0,0,2" BorderBrush="{DynamicResource CyanBrush}" IsHitTestVisible="False" />
                                        <Path Margin="-5,-12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                              Fill="{DynamicResource CyanBrush}" Data="M0,10 L6,0 L12,10 Z" IsHitTestVisible="False" />
                                        <Path Margin="0,0,-12,-5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                              Fill="{DynamicResource CyanBrush}" Data="M0,0 L10,6 L0,12 Z" IsHitTestVisible="False" />
                                    </Grid>

                                    <ItemsControl Grid.Row="1" Grid.Column="1" Margin="6,8,6,0"
                                                  Focusable="False" IsHitTestVisible="False"
                                                  ItemsSource="{Binding ChartBars}"
                                                  ItemsPanel="{StaticResource SingleRowPanel}"
                                                  ItemTemplate="{StaticResource ChartLabelTemplate}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ═════════════ BİLDİRİMLER (sağ alt) ═════════════ -->
            <ItemsControl Width="520" Margin="0,0,46,46" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Focusable="False" ItemsSource="{Binding Toasts}" ItemTemplate="{StaticResource ToastTemplate}" />

        </Grid>

        <!--
            ═════════════ GÖREV DÜZENLEYİCİ ═════════════
            Karartma katmanı da kesik köşeli: şeffaf köşelerin arkasındaki masaüstü kararmaz.
            Esc tüm pencere için EscapeCommand ile yönetilir.
        -->
        <Grid Style="{StaticResource OverlayWhenEditor}">
            <Grid.InputBindings>
                <KeyBinding Key="Return" Command="{Binding SaveEditCommand}" />
            </Grid.InputBindings>
            <local:ChamferFrame Fill="{StaticResource BackdropBrush}" Chamfer="30" Corners="All" />
            <Grid>
                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
                </Grid.LayoutTransform>
                <Grid Width="680" HorizontalAlignment="Center" VerticalAlignment="Center" DataContext="{Binding Editor}">
                    <!-- Düzenleyici genel ölçeğe göre %10 daha büyük (okunabilirlik) -->
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                    </Grid.LayoutTransform>
                    <local:ChamferFrame Fill="{StaticResource PanelBrush}" Stroke="{DynamicResource YellowBrush}"
                                        StrokeThickness="2" Chamfer="20" Corners="TopLeft, BottomRight" />
                    <!-- %100 ölçekte de pencereye sığsın (700 × 1.1 + kenar); taşan içerik kayar -->
                    <ScrollViewer MaxHeight="700" Margin="28,22,28,22" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False" RenderOptions.EdgeMode="Aliased">
                        <StackPanel RenderOptions.EdgeMode="Unspecified">
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource YellowBrush}" Text="{Binding Heading}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Title}" />
                            <TextBox x:Name="EditorTitleBox" Style="{StaticResource NeonTextBox}" MaxLength="120"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- Notlar: çok satırlı; Enter satır ekler (kaydetmez), Kaydet butonu veya başka alanda Enter ile kaydedilir -->
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Notes}" />
                            <TextBox Style="{StaticResource NeonTextBox}" MaxLength="4000" Tag="{loc:Tr Notes_Hint}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Category}" />
                                    <TextBox Style="{StaticResource NeonTextBox}" MaxLength="40" Tag="{loc:Tr Add_CategoryHint}"
                                             Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Hours}" />
                                    <TextBox Style="{StaticResource NeonTextBox}" MaxLength="5"
                                             Text="{Binding HoursText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Priority}" />
                            <ListBox Style="{StaticResource ChipList}" ItemContainerStyle="{StaticResource PriorityChipStyle}"
                                     ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding SelectedPriority}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_DueDate}" />
                                    <TextBox Style="{StaticResource NeonTextBox}" MaxLength="10"
                                             Text="{Binding DueDateText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_DueTime}" />
                                    <TextBox Style="{StaticResource NeonTextBox}" MaxLength="5"
                                             Text="{Binding DueTimeText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Quick_Today}" Command="{Binding SetDueTodayCommand}" />
                                <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Quick_Tomorrow}" Command="{Binding SetDueTomorrowCommand}" />
                                <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Quick_NextWeek}" Command="{Binding SetDueNextWeekCommand}" />
                                <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Quick_Clear}" Command="{Binding ClearDueCommand}" />
                            </WrapPanel>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Recurrence}" />
                            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding RecurrenceOptions}" SelectedItem="{Binding SelectedRecurrence}" />

                            <!-- Seçili günler: Pzt..Paz çipleri + hızlı seçimler -->
                            <StackPanel Margin="0,4,0,0">
                                <StackPanel.Visibility>
                                    <Binding Path="IsDaysRecurrence">
                                        <Binding.Converter>
                                            <BooleanToVisibilityConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </StackPanel.Visibility>
                                <TextBlock Margin="0,4,0,6" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Text="{loc:Tr Rec_DaysLabel}" />
                                <ItemsControl Focusable="False" ItemsSource="{Binding DayToggles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,6,6" Style="{StaticResource DayChipButton}" Content="{Binding Label}"
                                                    Command="{Binding DataContext.Editor.ToggleDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel>
                                    <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Rec_Weekdays}" Command="{Binding SelectWeekdaysCommand}" />
                                    <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Rec_Weekend}" Command="{Binding SelectWeekendCommand}" />
                                    <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Rec_AllDays}" Command="{Binding SelectAllDaysCommand}" />
                                </WrapPanel>
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0" FontSize="12" FontStyle="Italic" Foreground="{DynamicResource GreyBrush}" TextWrapping="Wrap" Text="{loc:Tr Rec_Note}">
                                <TextBlock.Visibility>
                                    <Binding Path="IsAnyRecurrence">
                                        <Binding.Converter>
                                            <BooleanToVisibilityConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </TextBlock.Visibility>
                            </TextBlock>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Reminder}" />
                            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding ReminderOptions}" SelectedItem="{Binding SelectedReminder}" />
                            <TextBlock Margin="0,2,0,0" FontSize="12" FontStyle="Italic" Foreground="{DynamicResource GreyBrush}" TextWrapping="Wrap" Text="{loc:Tr Edit_ReminderNote}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Subtasks}" />
                            <ItemsControl Focusable="False" ItemsSource="{Binding Subtasks}" ItemTemplate="{StaticResource EditorSubtaskTemplate}" />
                            <TextBox Margin="0,8,0,0" Style="{StaticResource NeonTextBox}" MaxLength="120" Tag="{loc:Tr Subtask_Hint}"
                                     Text="{Binding NewSubtaskTitle, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddSubtaskCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <TextBlock Margin="0,14,0,0" FontSize="14" Foreground="{StaticResource RedBrush}" TextWrapping="Wrap"
                                       Text="{Binding ValidationError}" />

                            <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Margin="0,0,12,0" Style="{StaticResource ChamferButton}" Content="{loc:Tr Edit_Cancel}"
                                        Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Button Style="{StaticResource AddButton}" Content="{loc:Tr Edit_Save}"
                                        Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═════════════ ŞABLONLAR ═════════════ -->
        <views:TemplatesOverlay>
            <views:TemplatesOverlay.Visibility>
                <Binding Path="IsTemplatesOpen">
                    <Binding.Converter>
                        <BooleanToVisibilityConverter />
                    </Binding.Converter>
                </Binding>
            </views:TemplatesOverlay.Visibility>
        </views:TemplatesOverlay>

        <!-- ═════════════ AYARLAR ═════════════ -->
        <views:SettingsOverlay>
            <views:SettingsOverlay.Visibility>
                <Binding Path="IsSettingsOpen">
                    <Binding.Converter>
                        <BooleanToVisibilityConverter />
                    </Binding.Converter>
                </Binding>
            </views:SettingsOverlay.Visibility>
        </views:SettingsOverlay>

        <!-- ═════════════ VERİ & YEDEK ═════════════ -->
        <views:DataOverlay>
            <views:DataOverlay.Visibility>
                <Binding Path="IsDataOpen">
                    <Binding.Converter>
                        <BooleanToVisibilityConverter />
                    </Binding.Converter>
                </Binding>
            </views:DataOverlay.Visibility>
        </views:DataOverlay>

        <!-- ═════════════ İLK AÇILIŞ REHBERİ ═════════════ -->
        <views:OnboardingOverlay>
            <views:OnboardingOverlay.Visibility>
                <Binding Path="IsOnboardingOpen">
                    <Binding.Converter>
                        <BooleanToVisibilityConverter />
                    </Binding.Converter>
                </Binding>
            </views:OnboardingOverlay.Visibility>
        </views:OnboardingOverlay>
    </Grid>
</Window>
