<UserControl x:Class="CyberTodo.Views.DataOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:local="clr-namespace:CyberTodo"
    xmlns:models="clr-namespace:CyberTodo.Models"
    xmlns:loc="clr-namespace:CyberTodo.Services"
    mc:Ignorable="po">
    <Grid>
        <local:ChamferFrame Fill="{StaticResource BackdropBrush}" Chamfer="30" Corners="All" />
        <Grid>
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
            </Grid.LayoutTransform>
            <Grid Width="720" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:ChamferFrame Fill="{StaticResource PanelBrush}" Stroke="{DynamicResource CyanBrush}"
                                    StrokeThickness="2" Chamfer="20" Corners="TopLeft, BottomRight" />
                <StackPanel Margin="28,22,28,24">
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource CyanBrush}" Text="{loc:Tr Data_Button}" />
                    <Rectangle Height="1" Margin="0,10,0,10" Fill="{DynamicResource CyanDimBrush}" />
                    <TextBlock FontSize="12" FontStyle="Italic" Foreground="{StaticResource GreyBrush}" TextWrapping="Wrap" Text="{loc:Tr Data_Help}" />

                    <!-- Yedekler -->
                    <Grid Margin="0,14,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource YellowBrush}" Text="{loc:Tr Data_Backups}" />
                        <Button Grid.Column="1" Style="{StaticResource SmallButton}" Margin="0" Content="{loc:Tr Data_BackupNow}" Command="{Binding BackupNowCommand}" />
                    </Grid>
                    <ScrollViewer MaxHeight="230" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Focusable="False" RenderOptions.EdgeMode="Aliased">
                        <ItemsControl Focusable="False" ItemsSource="{Binding Backups}" RenderOptions.EdgeMode="Unspecified">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:BackupInfo}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Kind" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource CyanBrush}" Text="{loc:Tr Data_Daily}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource WhiteBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"
                                                   Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy  HH:mm}'}" />
                                        <TextBlock Grid.Column="2" Margin="12,0" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{StaticResource GreyBrush}" Text="{Binding SizeText}" />
                                        <Button Grid.Column="3" Style="{StaticResource SmallButton}" Margin="0" Content="{loc:Tr Data_Restore}"
                                                Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDaily}" Value="False">
                                            <Setter TargetName="Kind" Property="Text" Value="{loc:Tr Data_Safety}" />
                                            <Setter TargetName="Kind" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{StaticResource GreyBrush}" Text="{loc:Tr Data_BackupsEmpty}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Backups.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Data_Folder}" />
                    <TextBox Style="{StaticResource NeonTextBox}" FontSize="12" IsReadOnly="True" Text="{Binding BackupDirectory, Mode=OneWay}" />
                    <!-- 400 günden eski tamamlananlar yıllık arşivde (yoksa gizli) -->
                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource GreyBrush}" TextWrapping="Wrap" Text="{Binding ArchiveText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ArchiveText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Dışa / içe aktarma -->
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Data_Export}" />
                    <WrapPanel>
                        <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Data_ExportJson}" Command="{Binding ExportJsonCommand}" />
                        <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Data_ExportCsv}" Command="{Binding ExportCsvCommand}" />
                        <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Data_ExportIcs}" Command="{Binding ExportIcsCommand}" />
                        <Rectangle Width="1" Height="22" Margin="6,0,14,0" Fill="{DynamicResource CyanDimBrush}" />
                        <Button Content="{loc:Tr Data_Import}" Command="{Binding ImportJsonCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource YellowBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource YellowBrush}" />
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource GreyBrush}" TextWrapping="Wrap" Text="{loc:Tr Data_IcsHelp}" />

                    <Button Margin="0,20,0,0" HorizontalAlignment="Right" Style="{StaticResource ChamferButton}"
                            Content="{loc:Tr Btn_Close}" Command="{Binding CloseDataCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
