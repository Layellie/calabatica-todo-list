<UserControl x:Class="CyberTodo.Views.FocusStatsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:local="clr-namespace:CyberTodo"
    xmlns:models="clr-namespace:CyberTodo.Models"
    xmlns:loc="clr-namespace:CyberTodo.Services"
    mc:Ignorable="po">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Aralık: 7 / 30 gün -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{loc:Tr Focus_7}" Command="{Binding SetFocusRangeCommand}" CommandParameter="7">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FocusRangeDays}" Value="7">
                                <Setter Property="Background" Value="{DynamicResource CyanBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource BlackBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{loc:Tr Focus_30}" Command="{Binding SetFocusRangeCommand}" CommandParameter="30">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FocusRangeDays}" Value="30">
                                <Setter Property="Background" Value="{DynamicResource CyanBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource BlackBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <ItemsControl Grid.Row="1" Focusable="False" ItemsSource="{Binding FocusTiles}" ItemTemplate="{StaticResource StatTileTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Grid Grid.Row="2" Margin="0,6,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Text="{loc:Tr Focus_ByCategory}" />
                <ItemsControl Focusable="False" ItemsSource="{Binding FocusByCategory}" ItemTemplate="{StaticResource FocusSliceTemplate}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,8" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Text="{loc:Tr Focus_ByTask}" />
                <ItemsControl Focusable="False" ItemsSource="{Binding FocusByTask}" ItemTemplate="{StaticResource FocusSliceTemplate}" />
            </StackPanel>
            <TextBlock Grid.ColumnSpan="3" Margin="0,30,0,0" FontSize="13" Foreground="{DynamicResource GreyBrush}"
                       TextWrapping="Wrap" Text="{loc:Tr Focus_Empty}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFocusData}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
