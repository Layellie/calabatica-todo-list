<UserControl x:Class="CyberTodo.Views.HabitsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:local="clr-namespace:CyberTodo"
    xmlns:models="clr-namespace:CyberTodo.Models"
    xmlns:loc="clr-namespace:CyberTodo.Services"
    mc:Ignorable="po">
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      Focusable="False" RenderOptions.EdgeMode="Aliased">
            <ItemsControl Focusable="False" ItemsSource="{Binding Habits}" RenderOptions.EdgeMode="Unspecified" Margin="0,0,10,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:HabitRow}">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource CyanBrush}"
                                           TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource AxisTextBrush}" TextTrimming="CharacterEllipsis">
                                    <Run Text="↻ " /><Run Text="{Binding RecurrenceText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding BestText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{loc:Tr Habit_Rate}" /><Run Text=" " /><Run Text="{Binding RateText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock x:Name="StreakValue" HorizontalAlignment="Right" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource GreyBrush}" Text="{Binding StreakText}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" Text="{loc:Tr Habit_Streak}" />
                            </StackPanel>
                            <!-- Son 28 gün: yapıldı / kaçırıldı / bugün bekliyor / planlı değil -->
                            <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" Focusable="False" ItemsSource="{Binding Cells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:HabitCell}">
                                        <Border x:Name="Cell" Height="12" Margin="1,0" Background="{StaticResource PanelAltBrush}"
                                                BorderBrush="{DynamicResource GreyBrush}" BorderThickness="0" ToolTip="{Binding Tip}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Done">
                                                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource CyanBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Missed">
                                                <Setter TargetName="Cell" Property="Background" Value="{StaticResource RedDimBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Pending">
                                                <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource YellowBrush}" />
                                                <Setter TargetName="Cell" Property="BorderThickness" Value="1.5" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsHot}" Value="True">
                                <Setter TargetName="StreakValue" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Margin="0,10,0,0" FontSize="13" Foreground="{DynamicResource GreyBrush}" TextWrapping="Wrap" Text="{loc:Tr Habits_Empty}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasHabits}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
