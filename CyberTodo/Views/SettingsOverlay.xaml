<UserControl x:Class="CyberTodo.Views.SettingsOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:local="clr-namespace:CyberTodo"
    xmlns:models="clr-namespace:CyberTodo.Models"
    xmlns:loc="clr-namespace:CyberTodo.Services"
    mc:Ignorable="po">
    <Grid>
        <local:ChamferFrame Fill="{StaticResource BackdropBrush}" Chamfer="30" Corners="All" />
        <Grid>
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
            </Grid.LayoutTransform>
            <Grid Width="940" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:ChamferFrame Fill="{StaticResource PanelBrush}" Stroke="{DynamicResource CyanBrush}"
                                    StrokeThickness="2" Chamfer="20" Corners="TopLeft, BottomRight" />
                <StackPanel Margin="28,22,28,24">
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource CyanBrush}">
                        <Run Text="⚙ " /><Run Text="{loc:Tr Settings_Title}" />
                    </TextBlock>
                    <Rectangle Height="1" Margin="0,10,0,0" Fill="{DynamicResource CyanDimBrush}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Sol: görünüm -->
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Language}" />
                            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguageOption}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Scale}" />
                            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding ScaleOptions}" SelectedItem="{Binding SelectedScaleOption}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Theme}" />
                            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeOption}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Sound}" />
                            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding SelectedSoundOption}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Focus}" />
                            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding FocusLengthOptions}" SelectedItem="{Binding SelectedFocusLengthOption}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Breaks}" />
                            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding SelectedBreaksOption}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_AutoNext}" />
                            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding SelectedAutoNextOption}" />
                        </StackPanel>

                        <!-- Sağ: sistem -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Tray}" />
                            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding SelectedTrayOption}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Startup}" />
                            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding SelectedStartupOption}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Updates}" />
                            <TextBlock FontSize="13" Foreground="{DynamicResource AxisTextBrush}" TextWrapping="Wrap">
                                <Run Text="{Binding VersionText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding UpdateStatusText, Mode=OneWay}" />
                            </TextBlock>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Update_Check}" Command="{Binding CheckUpdatesCommand}" />
                                <!-- Kurulu kopyada: indir → SHA256 doğrula → değiştir → yeniden başlat -->
                                <Button Content="{loc:Tr Update_InstallButton}" Command="{Binding InstallUpdateCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                            <Setter Property="Foreground" Value="{DynamicResource YellowBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource YellowBrush}" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanInstallUpdate}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Style="{StaticResource SmallButton}" Content="{loc:Tr Update_Open}" Command="{Binding OpenReleasePageCommand}">
                                    <Button.Visibility>
                                        <Binding Path="HasUpdate">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </Button.Visibility>
                                </Button>
                            </WrapPanel>
                            <TextBlock Margin="0,8,0,4" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Text="{loc:Tr Settings_AutoUpdate}" />
                            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding SelectedAutoUpdateOption}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_Shortcuts}" />
                            <TextBlock FontSize="13" LineHeight="20" Foreground="{DynamicResource AxisTextBrush}" TextWrapping="Wrap" Text="{loc:Tr Shortcuts_Text}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Settings_DataPath}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource NeonTextBox}" FontSize="12" IsReadOnly="True" Text="{Binding DataFilePath, Mode=OneWay}" />
                        <Button Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource ChamferButton}" FontSize="13"
                                Content="{loc:Tr Data_Button}" Command="{Binding OpenDataCommand}" />
                    </Grid>

                    <Button Margin="0,22,0,0" HorizontalAlignment="Right" Style="{StaticResource ChamferButton}"
                            Content="{loc:Tr Btn_Close}" Command="{Binding CloseSettingsCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
