<UserControl x:Class="CyberTodo.Views.StatsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:local="clr-namespace:CyberTodo"
    xmlns:models="clr-namespace:CyberTodo.Models"
    xmlns:loc="clr-namespace:CyberTodo.Services"
    mc:Ignorable="po">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ItemsControl Focusable="False" ItemsSource="{Binding StatTiles}" ItemTemplate="{StaticResource StatTileTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <TextBlock Grid.Row="1" Margin="0,6,0,8" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Text="{loc:Tr Stat_Weekdays}" />

        <!-- Haftanın günlerine göre ortalama (mini sütun grafiği, efektsiz) -->
        <ItemsControl Grid.Row="2" Focusable="False" ItemsSource="{Binding WeekdayStats}" ItemsPanel="{StaticResource SingleRowPanel}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:WeekdayStat}">
                    <Grid Margin="6,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{Binding EmptyHeight}" />
                            <RowDefinition Height="{Binding FillHeight}" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource AxisTextBrush}" Text="{Binding ValueText}" />
                        <Border x:Name="WdBar" Grid.Row="2" MaxWidth="46" Background="{DynamicResource CyanBrush}" />
                        <TextBlock x:Name="WdLabel" Grid.Row="3" Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource AxisTextBrush}" Text="{Binding Label}" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsBest}" Value="True">
                            <Setter TargetName="WdBar" Property="Background" Value="{DynamicResource YellowBrush}" />
                            <Setter TargetName="WdLabel" Property="Foreground" Value="{DynamicResource YellowBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
