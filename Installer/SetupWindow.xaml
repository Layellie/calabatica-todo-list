<Window x:Class="CalabaticaSetup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CALABATICA Setup"
        Icon="pack://application:,,,/calabatica.ico"
        Width="620" Height="440"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#000000" FontFamily="Cascadia Mono, Consolas" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="Yellow" Color="#FCEE0A" />
        <SolidColorBrush x:Key="Cyan" Color="#00F0FF" />
        <SolidColorBrush x:Key="Grey" Color="#8A94A6" />
        <SolidColorBrush x:Key="Red" Color="#FF003C" />

        <Style x:Key="HudButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Cyan}" />
            <Setter Property="BorderBrush" Value="{StaticResource Cyan}" />
            <Setter Property="Background" Value="#070D12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="22,8" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#4A5568" />
                                <Setter Property="BorderBrush" Value="#4A5568" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource HudButton}">
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="Background" Value="{StaticResource Yellow}" />
            <Setter Property="BorderBrush" Value="{StaticResource Yellow}" />
        </Style>

        <!-- HUD onay kutusu -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Cyan}" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="18" Height="18" Background="#070D12">
                                <Border BorderBrush="{TemplateBinding Foreground}" BorderThickness="1.5" />
                                <Path x:Name="Mark" Data="M3,9 L7,13 L15,4" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" Visibility="Hidden" />
                            </Grid>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Uygulamayla aynı çerçeve: cyan köşe üçgenleri + 45° kesik sarı kenar (pencere boyutu sabit) -->
        <Polygon Fill="{StaticResource Cyan}" Points="0,0 32,0 0,32" />
        <Polygon Fill="{StaticResource Cyan}" Points="620,0 620,32 588,0" />
        <Polygon Fill="{StaticResource Cyan}" Points="620,440 588,440 620,408" />
        <Polygon Fill="{StaticResource Cyan}" Points="0,440 0,408 32,440" />
        <Polygon Stroke="{StaticResource Yellow}" StrokeThickness="2" Fill="#000000"
                 Points="31,1 589,1 619,31 619,409 589,439 31,439 1,409 1,31" />

        <Grid Margin="40,30,40,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource Yellow}">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FCEE0A" BlurRadius="16" ShadowDepth="0" Opacity="0.8" />
                </TextBlock.Effect>
                <Run Text="CALABATICA" /><Run x:Name="TitleSuffix" FontSize="15" Foreground="#99FCEE0A" Text=" // KURULUM" />
            </TextBlock>

            <Rectangle Grid.Row="1" Height="1" Margin="0,12,0,14" Fill="#55FCEE0A" />

            <TextBlock x:Name="LeadText" Grid.Row="2" FontSize="14" Foreground="{StaticResource Cyan}" TextWrapping="Wrap" />

            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <TextBlock x:Name="LocationLabel" FontSize="11" Foreground="{StaticResource Grey}" />
                <TextBlock x:Name="LocationText" Margin="0,4,0,6" FontSize="12" Foreground="#5CA9B3" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="RuntimeText" Margin="0,0,0,6" FontSize="12" TextWrapping="Wrap" />
                <CheckBox x:Name="DesktopCheck" IsChecked="True" />
                <CheckBox x:Name="LaunchCheck" IsChecked="True" />
                <CheckBox x:Name="DeleteDataCheck" IsChecked="False" Foreground="{StaticResource Red}" Visibility="Collapsed" />
            </StackPanel>

            <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,14,0,0" VerticalAlignment="Bottom" FontSize="13"
                       Foreground="{StaticResource Yellow}" TextWrapping="Wrap" />

            <StackPanel Grid.Row="5" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Style="{StaticResource HudButton}" Click="Cancel_Click" />
                <Button x:Name="LaunchButton" Style="{StaticResource HudButton}" Click="Launch_Click" Visibility="Collapsed" />
                <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Click="Primary_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
